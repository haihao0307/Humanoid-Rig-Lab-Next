{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kaopu:reality:material-snapshot-set:1",
  "title": "KAOPU Reality HC S3 fixed material evidence set",
  "type": "object",
  "required": [
    "schema",
    "version",
    "objects",
    "registeredOnly"
  ],
  "properties": {
    "schema": {
      "const": "kaopu/reality-material-snapshot-set@1"
    },
    "version": {
      "const": "REALITY-HC-S3"
    },
    "objects": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "family",
          "name",
          "priority",
          "mode",
          "summary",
          "source",
          "measurements",
          "checks",
          "defects"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "family": {
            "enum": [
              "denim",
              "knit",
              "leather",
              "silk",
              "cotton",
              "acrylic",
              "linen"
            ]
          },
          "name": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "mode": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "source": {
            "type": "object"
          },
          "measurements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "definitionId",
                "label",
                "value",
                "unit",
                "status",
                "basis",
                "note"
              ],
              "properties": {
                "definitionId": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "PASS",
                    "FAIL",
                    "WARNING",
                    "UNKNOWN",
                    "NOT_APPLICABLE"
                  ]
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceRef": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "checks": {
            "type": "array"
          },
          "defects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "code",
                "status",
                "owner",
                "expected",
                "observed",
                "repairAuthorized",
                "verificationRequired"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "FAIL",
                    "WARNING",
                    "UNKNOWN"
                  ]
                },
                "owner": {
                  "type": "string"
                },
                "expected": {
                  "type": "string"
                },
                "observed": {
                  "type": "string"
                },
                "repairAuthorized": {
                  "const": false
                },
                "verificationRequired": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    "registeredOnly": {
      "type": "array"
    }
  },
  "$comment": "Schema validates structure. contract.js additionally validates units, statuses, family coverage, dimensional semantics and non-repair authority."
}