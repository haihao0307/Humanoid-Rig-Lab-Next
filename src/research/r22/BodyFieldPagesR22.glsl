// Lossless virtual field-node fetch. Interpolation remains in the original order.
uniform highp usampler3D uFieldPages,uLocalPages0,uLocalPages1,uLocalPages2,uLocalPages3;
uniform sampler2D uFieldAxes;uniform int uPageEncoding[5];uniform ivec3 uPageShape[5];
vec4 pageNode(sampler3D tex,highp usampler3D pages,ivec3 i,int region,bool normalField){if(uPageEncoding[region]==0)return texelFetch(tex,i,0);uint value=texelFetch(pages,i/8,0).r;if(value==0u){if(normalField)return vec4(0.,0.,0.,1.);return vec4(.035,texelFetch(uFieldAxes,ivec2(i.x,region*3),0).r,texelFetch(uFieldAxes,ivec2(i.y,region*3+1),0).r,texelFetch(uFieldAxes,ivec2(i.z,region*3+2),0).r);}int id=int(value)-1;ivec3 slots=uPageShape[region],origin=ivec3(id%slots.x,(id/slots.x)%slots.y,id/(slots.x*slots.y))*8;return texelFetch(tex,origin+i%8,0);}
vec4 fieldValues(sampler3D tex,highp usampler3D pages,vec3 p,vec3 bmin,vec3 bmax,vec3 grid,int region,bool normalField){vec3 q=(p-bmin)/(bmax-bmin)*grid-.5;ivec3 lo=ivec3(floor(q)),top=ivec3(grid)-1;vec3 f=fract(q);vec4 v[8];int n=0;for(int z=0;z<=1;z++)for(int y=0;y<=1;y++)for(int x=0;x<=1;x++){ivec3 i=clamp(lo+ivec3(x,y,z),ivec3(0),top);v[n++]=pageNode(tex,pages,i,region,normalField);}vec4 value=mix(mix(mix(v[0],v[1],f.x),mix(v[2],v[3],f.x),f.y),mix(mix(v[4],v[5],f.x),mix(v[6],v[7],f.x),f.y),f.z);vec3 outside=max(max(bmin-p,p-bmax),vec3(0));if(any(greaterThan(outside,vec3(0))))value.r=max(value.r,length(outside));return value;}
