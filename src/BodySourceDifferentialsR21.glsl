// Evaluate the same source affine surface at quad helper rays. Screen-space
// neighbours can hit a different body layer; never differentiate across them.
struct SourcePlanePoint{vec3 p;vec3 n;vec3 rest;float dry;};
struct SourceDifferential{vec3 dx;vec3 dy;vec3 nx;vec3 ny;float hx;float hy;};
vec4 sourceFieldRecord(sampler2D data,int i,int width){return texelFetch(data,ivec2(i%width,i/width),0);}
vec3 sourceCameraRay(vec2 pixel,vec2 resolution,vec3 eye,vec3 target){vec2 screen=(pixel-.5*resolution)/resolution.y;vec3 forward=normalize(target-eye),right=normalize(cross(forward,vec3(0,1,0))),up=cross(right,forward);return normalize(forward+.95*(screen.x*right+screen.y*up));}
SourcePlanePoint sourcePlanePoint(sampler2D fields,sampler2D skins,int width,int field,int axis,vec3 eye,vec3 ray){vec4 a=sourceFieldRecord(fields,field*3,width),b=sourceFieldRecord(fields,field*3+1,width),c=sourceFieldRecord(fields,field*3+2,width);vec2 o=axis==0?eye.yz:axis==1?eye.zx:eye.xy,d=axis==0?ray.yz:axis==1?ray.zx:ray.xy;float t=(dot(a.xy,o)+a.z-eye[axis])/(ray[axis]-dot(a.xy,d));vec2 uv=o+d*t;SourcePlanePoint result;result.p=eye+ray*t;result.n=normalize(vec3(a.w*uv.x+b.x*uv.y+b.y,b.z*uv.x+b.w*uv.y+c.x,c.y*uv.x+c.z*uv.y+c.w));vec4 sa=sourceFieldRecord(skins,field*3,width),sb=sourceFieldRecord(skins,field*3+1,width),sc=sourceFieldRecord(skins,field*3+2,width);result.rest=vec3(dot(sa.xyz,vec3(uv,1.)),sa.w*uv.x+sb.x*uv.y+sb.y,sb.z*uv.x+sb.w*uv.y+sc.x);result.dry=clamp(dot(sc.yzw,vec3(uv,1.)),0.,1.);return result;}
SourceDifferential sourceDifferentials(sampler2D fields,sampler2D skins,int width,int field,int axis,vec2 pixel,vec2 resolution,vec3 eye,vec3 target){vec2 base=floor(pixel*.5)*2.+.5;SourcePlanePoint left=sourcePlanePoint(fields,skins,width,field,axis,eye,sourceCameraRay(vec2(base.x,pixel.y),resolution,eye,target)),right=sourcePlanePoint(fields,skins,width,field,axis,eye,sourceCameraRay(vec2(base.x+1.,pixel.y),resolution,eye,target)),bottom=sourcePlanePoint(fields,skins,width,field,axis,eye,sourceCameraRay(vec2(pixel.x,base.y),resolution,eye,target)),top=sourcePlanePoint(fields,skins,width,field,axis,eye,sourceCameraRay(vec2(pixel.x,base.y+1.),resolution,eye,target));SourceDifferential result;result.dx=right.p-left.p;result.dy=top.p-bottom.p;result.nx=right.n-left.n;result.ny=top.n-bottom.n;result.hx=sourceHeight(right.rest,right.dry)-sourceHeight(left.rest,left.dry);result.hy=sourceHeight(top.rest,top.dry)-sourceHeight(bottom.rest,bottom.dry);return result;}
