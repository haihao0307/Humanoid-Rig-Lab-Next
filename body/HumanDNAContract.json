    "force": "N",
    "torque": "N m",
    "temperature": "degC",
    "heatFlow": "W",
    "hairDiameter": "um"
  },
  "structureRecipes": [
    {
      "id": "rig",
      "source": "source/runtime.template.js",
      "function": "Human.build",
