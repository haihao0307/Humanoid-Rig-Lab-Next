  "principles": [
    "Identity and parameter recipes are canonical; generated vertices are disposable.",
    "Authored anatomy is a design claim, not an observation of a person.",
    "Rendering, validation, and packaging do not create independent observation roots.",
    "Keep state changes separate from read-only queries.",
    "Retain Unknown, NotObserved, ObservedAbsent and NotApplicable as distinct states.",
    "Source revisions remain addressable; generator changes create a new revision."
  ],
  "referenceFrame": {
    "id": "human-bind-m",
    "axes": {
      "x": "anatomical right",
      "y": "up",
      "z": "anterior"
    },
    "lengthUnit": "m",
    "handedness": "right",
    "frameOrigin": "ground plane below the neutral rig; local part coordinates relative to named joints"
  },
  "timeBinding": {
    "source": "HumanLab.human.tissue.time",
    "unit": "s",
    "kind": "simulation",
    "elapsedState": "biology.state.elapsedS",
    "wallClockEquivalence": false
  },
  "quantityUnits": {
    "length": "m",
    "skinThickness": "mm",
