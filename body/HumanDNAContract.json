      "inputs": [
        "morph parameters",
        "muscle volume ratios"
      ]
    },
    {
      "id": "skinLayers",
      "source": "body/SkinLayers.js",
      "function": "buildSkinLayerSurfaces",
      "inputs": [
        "generated exterior",
        "regional thickness parameters"
      ]
    },
    {
      "id": "muscles",
      "source": "body/ProceduralTissue.js",
      "function": "ProceduralTissue.makeMuscles",
      "inputs": [
        "joint attachments",
        "muscle radii"
      ]
    },
    {
      "id": "organsAndPaths",
      "source": "body/ProceduralSystems.js",
      "function": "buildProceduralSystems",
      "inputs": [
        "authored landmarks",
        "ellipsoid and sweep functions"
      ]
    },
    {
      "id": "hair",
      "source": "body/ProceduralHair.js",
      "function": "ProceduralHair",
      "inputs": [
        "generated scalp",
        "seed",
        "follicle priors"
      ]
    }
  ],
  "surfaceProgram": {
    "source": "body/TissueShaders.js",
    "coordinates": "stable material/rest coordinates",
    "authoredImageMaps": 0
  },
  "precisionPolicy": {
    "implemented": "fixed procedural topology and bounded hair budget",
    "adaptiveReconstruction": "NotImplemented",
    "noStoredLODMeshes": true
