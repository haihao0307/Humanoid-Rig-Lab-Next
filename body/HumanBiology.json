{
  "schema": "jarvis/human_biology@1",
  "revision": "2026-09-11-r7",
  "scope": "Adult anatomical reference and reduced environmental response; not a complete organism or a measured individual",
  "sources": {
    "bone": "https://openstax.org/books/anatomy-and-physiology-2e/pages/6-3-bone-structure",
    "joint": "https://openstax.org/books/anatomy-and-physiology-2e/pages/9-4-synovial-joints",
    "muscle": "https://openstax.org/books/anatomy-and-physiology-2e/pages/10-2-skeletal-muscle",
    "contraction": "https://openstax.org/books/anatomy-and-physiology-2e/pages/10-3-muscle-fiber-contraction-and-relaxation",
    "skin": "https://openstax.org/books/anatomy-and-physiology-2e/pages/5-1-layers-of-the-skin",
    "appendages": "https://openstax.org/books/anatomy-and-physiology-2e/pages/5-2-accessory-structures-of-the-skin",
    "heat": "https://openstax.org/books/anatomy-and-physiology-2e/pages/24-6-energy-and-heat-balance",
    "homeostasis": "https://openstax.org/books/biology-2e/pages/33-3-homeostasis",
    "atlas": "https://dbarchive.biosciencedbc.jp/en/bodyparts3d/download.html",
    "motion": "https://mocap.cs.cmu.edu/"
  },
  "systems": [
    {
      "id": "skeleton",
      "label": "骨骼",
      "facts": "骨提供支撑和肌腱附着点；皮质骨与松质骨具有不同结构。",
      "sources": [
        "bone"
      ],
      "implementation": "从同源骨数据估算 128 个控制节点。显示由曲面函数生成，未加载骨扫描网格。"
    },
    {
      "id": "joints",
      "label": "关节、软骨与韧带",
      "facts": "关节决定相邻骨的运动方式；软骨覆盖关节面，韧带参与稳定。",
      "sources": [
        "joint"
      ],
      "implementation": "关节中心是可复算的静态几何估计，未做功能关节中心标定。活动范围为群体参考约束。"
    },
    {
      "id": "muscle",
      "label": "骨骼肌、筋膜与肌腱",
      "facts": "肌纤维的收缩经结缔组织和肌腱传递到骨；持续活动需要能量并产热。",
      "sources": [
        "muscle",
        "contraction",
        "heat"
      ],
      "implementation": "保留独立的能力与疲劳估算。没有实测的肌肉形变数据，不再用能力参数修改 R2 形体。"
    },
    {
      "id": "skin",
      "label": "皮肤与皮下组织",
      "facts": "表皮覆盖真皮；皮下组织位于皮肤深面。部位不同，覆盖厚度不同。",
      "sources": [
        "skin"
      ],
      "implementation": "按来源分区和骨段轴线计算权重，使用双四元数蒙皮；未模拟或声称实测压缩、滑移与鼓包。"
    },
    {
      "id": "hair",
      "label": "毛发、毛囊与皮肤附属器",
      "facts": "发干是角化结构；毛囊连接皮肤。汗腺分泌、毛囊活动与外露发干是不同过程。",
      "sources": [
        "appendages"
      ],
      "implementation": "头皮表面绑定、区域毛发先验、发束风动已接入；体毛、毛发生长周期、汗腺微几何未生成。"
    },
    {
      "id": "nervous",
      "label": "神经与反馈",
      "facts": "环境变化可通过感觉和反馈调节身体状态。",
      "sources": [
        "homeostasis"
      ],
      "implementation": "仅有简化温度反馈，无神经网格和神经元模拟。"
    },
    {
      "id": "circulation",
      "label": "循环与散热",
      "facts": "皮肤血流变化影响内部与体表之间的热交换。",
      "sources": [
        "heat"
      ],
      "implementation": "仅有核心与皮肤两个热状态，无血管网格、血流或血压模拟。"
    },
    {
      "id": "metabolism",
      "label": "代谢、水分与能量",
      "facts": "活动产热，蒸发可以带走热量；环境湿度会限制蒸发。",
      "sources": [
        "heat"
      ],
      "implementation": "活动产热、汗液损失与环境负荷估计；没有营养吸收或器官代谢求解器。"
    },
    {
      "id": "viscera",
      "label": "其他器官系统",
      "facts": "器官参考图层用于结构定位。",
      "sources": [
        "atlas"
      ],
      "implementation": "未生成器官网格，也未建模呼吸、消化等器官功能。"
    }
  ],
