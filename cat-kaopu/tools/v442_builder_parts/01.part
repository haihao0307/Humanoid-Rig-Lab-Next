    t=replace_once(t,"眼球仍使用 V4.40 轻量球体；V4.41 只在眼球片元层建立上下眼睑开合、确定性眨眼、角膜湿润高光与瞳孔适应。它不是几何眼皮、泪膜折射或第三眼睑，不能替代后续真实眼眶与眼睑体积。短毛层仍只改变方向性明暗。","眼球继续使用 V4.40 轻量球体。V4.42 在不改动 CATV440 载荷的条件下，按眼球真实包围盒生成独立上、下眼睑曲面，并绑定到 head 的最终蒙皮矩阵。眼睑具有受限眼缘隆起和闭合缝，但仍不是与面部拓扑连续的最终眼皮，也未加入第三眼睑或真实泪膜折射。","eye note")
    t=replace_once(t,'<section><h2>本轮边界</h2><div class="note">本轮不改变 V4.32 中性猫体、不改变 V4.40 二进制载荷与 34 骨权重、不改变 V4.39 坐卧修形，也不改变掌垫接触、直行和转向。新增内容只位于眼球片元表现层：程序化眼睑开合、眨眼、角膜响应和瞳孔适应。真实几何眼睑、第三眼睑、泪膜折射、胡须和几何毛束仍未完成。</div></section>','<section><h2>本轮边界</h2><div class="note">本轮只新增独立程序化眼睑覆盖层：V4.32 中性整猫表面、V4.40 CATV440 二进制载荷、34 骨、蒙皮权重、V4.39 坐卧修形以及 V4.36 运动接触均保持不变。新增几何不写回基础载荷，不允许用眼睑遮盖眼眶和头脸比例问题。面部连续拓扑、第三眼睑、泪膜折射、胡须和几何毛束仍未完成。</div></section>',"boundary")
    t=replace_once(t,'<section><h2>测试顺序</h2><div class="note">先检查“眼睑 / 角膜检查”：自动眨眼应完整闭合并恢复，手动闭眼 0→1 不得移动眼球几何；再检查不同瞳孔适应和角膜湿润值，确认高光与瞳孔宽度变化受限。随后检查耳眼追踪、站立、坐姿、趴卧、直行和转向，确认 V4.39 修形与 V4.36 运动没有回归。</div></section>','<section><h2>测试顺序</h2><div class="note">先用“几何眼睑 / 角膜检查”核对 0、0.5、1.0 三个闭合量；正面必须完整闭合，三分之四与侧面不得出现悬空圆片、穿入眼球或左右眼错位。再切换站立、坐姿、趴卧、直行、转向与耳眼追踪，确认眼睑始终跟随 head 矩阵且基础身体、接触和短毛方向没有回归。</div></section>',"test")
    line_marker="const lineFS=`#version 300 es\nprecision highp float;uniform vec4 uColor;out vec4 outColor;void main(){outColor=uColor;}`;\n"
    lid_shader=r'''const lidVS=`#version 300 es
precision highp float;layout(location=0)in vec3 aPos;layout(location=1)in vec3 aNormal;layout(location=2)in float aRim;uniform mat4 uPV;uniform mat4 uHeadSkin;out vec3 vN;out float vRim;void main(){vec4 p=uHeadSkin*vec4(aPos,1.);vN=normalize(mat3(uHeadSkin)*aNormal);vRim=aRim;gl_Position=uPV*p;}`;
const lidFS=`#version 300 es
precision highp float;in vec3 vN;in float vRim;uniform float uDebug;out vec4 outColor;void main(){vec3 n=normalize(vN),l1=normalize(vec3(.45,-.55,.82)),l2=normalize(vec3(-.62,.35,.35));float d=.20+.69*max(dot(n,l1),0.)+.18*max(dot(n,l2),0.);float rim=smoothstep(.52,1.,vRim);vec3 base=vec3(.69,.655,.59),col=base*d;col*=1.-.12*rim;float sheen=pow(max(dot(n,normalize(vec3(.52,-.28,.80))),0.),46.);col+=vec3(.16,.14,.12)*sheen*(1.-.65*rim);if(uDebug>.5)col=mix(col,vec3(.08,.72,.90),.72*(.25+.75*rim));outColor=vec4(pow(max(col,vec3(0.)),vec3(1./2.2)),1.);}`;
'''
    t=replace_once(t,line_marker,line_marker+lid_shader,"lid shader")
    t=replace_once(t,"const pr=program(gl,vs,fs),lpr=program(gl,lineVS,lineFS);gl.useProgram(pr);","const pr=program(gl,vs,fs),lpr=program(gl,lineVS,lineFS),lidPr=program(gl,lidVS,lidFS);gl.useProgram(pr);","program")
    marker2="const ib=gl.createBuffer();gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER,ib);gl.bufferData(gl.ELEMENT_ARRAY_BUFFER,m.idx,gl.STATIC_DRAW);gl.bindVertexArray(null);\n"
    geom=r'''const LID_SEGMENTS=32,LID_ROWS=5,LID_FLOATS=7,LID_MAX_VERTICES=2*2*LID_SEGMENTS*LID_ROWS*6;
function deriveEyeSpecs(mesh){const groups=[{sign:1,min:[Infinity,Infinity,Infinity],max:[-Infinity,-Infinity,-Infinity],count:0},{sign:-1,min:[Infinity,Infinity,Infinity],max:[-Infinity,-Infinity,-Infinity],count:0}];for(let i=0;i<mesh.vc;i++){if(mesh.part[i]<.5)continue;const x=mesh.pos[i*3],y=mesh.pos[i*3+1],z=mesh.pos[i*3+2],g=groups[y>=0?0:1];g.count++;g.min[0]=Math.min(g.min[0],x);g.min[1]=Math.min(g.min[1],y);g.min[2]=Math.min(g.min[2],z);g.max[0]=Math.max(g.max[0],x);g.max[1]=Math.max(g.max[1],y);g.max[2]=Math.max(g.max[2],z)}return groups.map(g=>{const c=[(g.min[0]+g.max[0])*.5,(g.min[1]+g.max[1])*.5,(g.min[2]+g.max[2])*.5],r=[(g.max[0]-g.min[0])*.5,(g.max[1]-g.min[1])*.5,(g.max[2]-g.min[2])*.5];return{sign:g.sign,center:c,radius:(r[0]+r[1]+r[2])/3,halfY:r[1],halfZ:r[2],count:g.count}})}
const EYE_SPECS=deriveEyeSpecs(m),lidData=new Float32Array(LID_MAX_VERTICES*LID_FLOATS);let lidVertexCount=0,lidDebug=false,lidShellOffset=.00018,lidRimLift=.00015;
