function lidPoint(spec,u,z,rim){const cy=spec.center[1],cz=spec.center[2],r=spec.radius,y=cy+u*spec.halfY*.965,dz=z,rad=Math.max(1e-10,r*r-(y-cy)*(y-cy)-dz*dz),front=Math.sqrt(rad),x=spec.center[0]+front+lidShellOffset+lidRimLift*rim*rim,nx=front/r,ny=(y-cy)/r,nz=dz/r,nl=Math.hypot(nx,ny,nz)||1;return[x,y,cz+dz,nx/nl,ny/nl,nz/nl,rim]}
function writeLidVertex(p){const o=lidVertexCount*LID_FLOATS;for(let i=0;i<LID_FLOATS;i++)lidData[o+i]=p[i];lidVertexCount++}
function buildGeometricLids(blink){lidVertexCount=0;const close=smooth01(Math.max(0,Math.min(1,blink))),lowerClose=close*close;for(const spec of EYE_SPECS){for(const upper of[true,false]){for(let i=0;i<LID_SEGMENTS;i++){const ua=-1+2*i/LID_SEGMENTS,ub=-1+2*(i+1)/LID_SEGMENTS;for(let row=0;row<LID_ROWS;row++){const ta=row/LID_ROWS,tb=(row+1)/LID_ROWS;const point=(u,t)=>{const arc=Math.sqrt(Math.max(0,1-u*u)),openCenter=-.00014+.00005*u*spec.sign,upperOpen=openCenter+.00355*arc,lowerOpen=openCenter-.00275*arc,seam=-.00018+.00028*(1-u*u),outerUpper=.00870*arc+.00018*(1-u*u),outerLower=-.00845*arc-.00012*(1-u*u),edge=upper?(upperOpen+(seam-upperOpen)*close):(lowerOpen+(seam-lowerOpen)*lowerClose),outer=upper?outerUpper:outerLower,z=outer+(edge-outer)*Math.pow(t,.88),rim=Math.pow(t,5.5);return lidPoint(spec,u,z,rim)};const p00=point(ua,ta),p10=point(ub,ta),p01=point(ua,tb),p11=point(ub,tb);if(upper){writeLidVertex(p00);writeLidVertex(p10);writeLidVertex(p11);writeLidVertex(p00);writeLidVertex(p11);writeLidVertex(p01)}else{writeLidVertex(p00);writeLidVertex(p11);writeLidVertex(p10);writeLidVertex(p00);writeLidVertex(p01);writeLidVertex(p11)}}}}}return lidVertexCount}
const lidVao=gl.createVertexArray();gl.bindVertexArray(lidVao);const lidBuf=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,lidBuf);gl.bufferData(gl.ARRAY_BUFFER,lidData.byteLength,gl.DYNAMIC_DRAW);gl.enableVertexAttribArray(0);gl.vertexAttribPointer(0,3,gl.FLOAT,false,LID_FLOATS*4,0);gl.enableVertexAttribArray(1);gl.vertexAttribPointer(1,3,gl.FLOAT,false,LID_FLOATS*4,3*4);gl.enableVertexAttribArray(2);gl.vertexAttribPointer(2,1,gl.FLOAT,false,LID_FLOATS*4,6*4);gl.bindVertexArray(null);
const LID_U={pv:gl.getUniformLocation(lidPr,'uPV'),head:gl.getUniformLocation(lidPr,'uHeadSkin'),debug:gl.getUniformLocation(lidPr,'uDebug')};
function drawGeometricLids(pv,mats){if(!blinkLayerEnabled)return 0;const count=buildGeometricLids(expressionState.blink);gl.useProgram(lidPr);gl.bindVertexArray(lidVao);gl.bindBuffer(gl.ARRAY_BUFFER,lidBuf);gl.bufferSubData(gl.ARRAY_BUFFER,0,lidData.subarray(0,count*LID_FLOATS));gl.uniformMatrix4fv(LID_U.pv,false,pv);gl.uniformMatrix4fv(LID_U.head,false,mats.skin.subarray(names.head*16,names.head*16+16));gl.uniform1f(LID_U.debug,lidDebug?1:0);gl.disable(gl.CULL_FACE);gl.enable(gl.POLYGON_OFFSET_FILL);gl.polygonOffset(-1,-1);gl.drawArrays(gl.TRIANGLES,0,count);gl.disable(gl.POLYGON_OFFSET_FILL);gl.enable(gl.CULL_FACE);gl.bindVertexArray(null);return count}
'''
    t=replace_once(t,marker2,marker2+geom,"geometry")
    t=replace_once(t,'<button class="active" id="blinkToggle">几何眼睑</button><button class="active" id="corneaToggle">','<button class="active" id="blinkToggle">几何眼睑</button><button id="lidDebugToggle">眼睑检查</button><button class="active" id="corneaToggle">',"debug button")
    t=replace_once(t,"gl.uniform1f(U.lid,blinkLayerEnabled?1:0);gl.uniform1f(U.blink,expressionState.blink);","gl.uniform1f(U.lid,0);gl.uniform1f(U.blink,0);","disable shader lid")
    t=replace_once(t,"gl.drawElements(gl.TRIANGLES,m.ic,gl.UNSIGNED_SHORT,0);gl.bindVertexArray(null);drawLines(pv,mats.jpos);lastPose=pose;","gl.drawElements(gl.TRIANGLES,m.ic,gl.UNSIGNED_SHORT,0);gl.bindVertexArray(null);const lidCount=drawGeometricLids(pv,mats);drawLines(pv,mats.jpos);lastPose=pose;","draw lids")
    t=replace_once(t,"$('#kBlink').textContent=(expressionState.blinkMode==='auto'?'自动 ':'手动 ')+expressionState.blink.toFixed(2);$('#kCornea')","$('#kBlink').textContent=(expressionState.blinkMode==='auto'?'自动 ':'手动 ')+expressionState.blink.toFixed(2);$('#kLidMesh').textContent=lidCount.toLocaleString()+' 顶点';$('#kCornea')","kpi runtime")
    t=replace_once(t,"expression:{...expressionState,autoBlink,eyeLayerEnabled,blinkLayerEnabled,corneaLayerEnabled,earLayerEnabled,furLayerEnabled,corneaResponse,pupilAdapt,furStrength,furDebugEnabled},camera:","expression:{...expressionState,autoBlink,eyeLayerEnabled,blinkLayerEnabled,corneaLayerEnabled,earLayerEnabled,furLayerEnabled,corneaResponse,pupilAdapt,furStrength,furDebugEnabled},eyelidGeometry:{enabled:blinkLayerEnabled,vertexCount:lidCount,triangles:lidCount/3,eyeSpecs:EYE_SPECS.map(e=>({center:e.center.slice(),radius:e.radius})),headAttached:true,shellOffsetM:lidShellOffset,rimLiftM:lidRimLift,debug:lidDebug},camera:","metrics geometry")
