"},motion="";
async function decode(b64){const bytes=Uint8Array.from(atob(b64),c=>c.charCodeAt(0));return JSON.parse(await new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'))).text())}
window.PALAU_SURFACES={};window.PALAU_BINDINGS={};for(const id of Object.keys(surfaces)){window.PALAU_SURFACES[id]=await decode(surfaces[id]);window.PALAU_BINDINGS[id]=await decode(bindings[id])}window.PALAU_MOTIONS=await decode(motion);
const blob=s=>URL.createObjectURL(new Blob([s],{type:'text/javascript'})),core=blob(sources.core),three=blob(sources.three.replaceAll("'./three.core.js'",JSON.stringify(core))),surface=blob(sources.surface.replace("'../vendor/three.module.js'",JSON.stringify(three))),motionModule=blob(sources.motion.replace("'../vendor/three.module.js'",JSON.stringify(three))),rig=blob(sources.rig.replace("'../vendor/three.module.js'",JSON.stringify(three)).replace("'./full-surface.js'",JSON.stringify(surface)).replace("'./source-animation.js'",JSON.stringify(motionModule))),app=blob(sources.app.replace("'../vendor/three.module.js'",JSON.stringify(three)).replace("'./full-surface.js'",JSON.stringify(surface)).replace("'./anatomical-rig.js'",JSON.stringify(rig)));await import(app);</script></body></html>
