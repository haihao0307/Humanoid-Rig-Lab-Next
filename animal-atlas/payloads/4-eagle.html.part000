<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>白头海雕 R07 · 头嘴重构与生命状态试演</title><style>
:root{font-family:system-ui,"Microsoft YaHei",sans-serif;color:#e5ecf0;background:#172128;--line:#3a4b55;--muted:#a4b8c4;--accent:#afd6c6}*{box-sizing:border-box}body{margin:0}header{height:76px;padding:15px 24px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}h1{font-size:20px;margin:0 0 6px;font-weight:600}header p{margin:0;font-size:12px;color:var(--muted)}.version{font:11px/1.6 monospace;color:var(--accent);text-align:right}main{display:grid;grid-template-columns:minmax(0,1fr) 322px;height:calc(100dvh - 76px)}#stage{position:relative;min-height:0;min-width:0;background:#c9cccc;overflow:hidden}canvas{display:block;width:100%;height:100%;touch-action:none}aside{overflow-y:auto;padding:12px 16px 25px;border-left:1px solid var(--line);background:#202d35}section{padding:10px 0 15px;border-bottom:1px solid var(--line)}h2,summary{font-size:12px;color:#bacbd5;font-weight:600;margin:0 0 9px}button,select{font:12px system-ui;color:#e5eef2;background:#2b3e48;border:1px solid #4e6370;border-radius:5px;padding:9px 8px;cursor:pointer}button:hover,button.active{background:#38565e;border-color:#9ed1c2}button.active{color:#d8f5e8}input{accent-color:#afd6c6}input[type=range]{width:100%}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.two{grid-template-columns:repeat(2,1fr)}.row{display:flex;gap:8px;align-items:center;font-size:12px;margin:8px 0}.spread{justify-content:space-between}.meta{font-size:11px;line-height:1.75;color:#a9becb}.note{font-size:11px;line-height:1.7;border-left:2px solid #c4a56d;padding-left:8px;color:#cbbda6}.wide,select{width:100%}#scenarios{display:grid;gap:7px}#scenarios button{text-align:left;padding:11px}#scenarios button span{display:block;font-size:10px;margin-top:4px;color:#a3bcc8}#loading{position:absolute;inset:0;z-index:4;background:#c9cccced;display:flex;align-items:center;justify-content:center;color:#253842;padding:20px}#badge{position:absolute;left:20px;top:18px;padding:9px 12px;background:#203239dc;border-radius:7px;pointer-events:none;font-size:11px;line-height:1.7}#badge b{color:#b5e1d0}#story{position:absolute;left:20px;right:20px;bottom:20px;background:#21333be8;border:1px solid #9bb7be55;border-radius:9px;padding:14px 16px;pointer-events:none;max-width:680px}#story h3{font-size:15px;margin:0 0 7px;color:#dbede5}#story p{font-size:11px;margin:0 0 10px;color:#bbccd3;line-height:1.6}#phaseRail{display:flex;gap:3px;height:4px}#phaseRail span{background:#58717b;border-radius:2px}#phaseRail span.on{background:#b2d9be}.minirow{display:flex;gap:14px;flex-wrap:wrap;font:10px/1.7 monospace;color:#c2d5df;margin-top:10px}#phaseButtons{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px}#phaseButtons button{font-size:10px;padding:5px}#signals{font:10px/1.8 monospace;white-space:pre-wrap;color:#bcd0da}.pill{font:10px monospace;color:#99bbb4}details{margin-top:8px}summary{cursor:pointer}#error{display:none;margin-top:8px}.footer{font-size:10px;line-height:1.75;color:#91a9b6;margin-top:15px}a{color:#badccc}
@media(max-width:850px){header{height:66px;padding:10px 13px}h1{font-size:16px}header p{font-size:10px}.version{display:none}main{height:calc(100dvh - 66px);grid-template-columns:1fr;grid-template-rows:55vh 1fr}aside{border-left:0;border-top:1px solid var(--line)}#badge{left:10px;top:10px;font-size:9px;padding:6px 8px}#story{left:10px;right:10px;bottom:10px;padding:9px 11px}#story h3{font-size:12px}#story p{display:none}#story{padding:7px 10px}#story h3{margin-bottom:5px}.minirow{display:none}#scenarios{grid-template-columns:1fr 1fr}#scenarios button{font-size:11px;padding:8px}#scenarios span{font-size:9px}}
</style></head><body><header><div><h1>KAOPU · 白头海雕 R07</h1><p>生活目标 → 全身协作 → 连续恢复　｜　眼区重构 · 下喙纠偏 · 动作幅度增强</p></div><div class="version">LIFE SEQUENCES / R07<br>实景行为候选 · 非生物力学定标</div></header><main><div id="stage"><canvas id="view"></canvas><div id="badge"><b>来源表面 · 真实 WebGL 演奏</b><br>拖动旋转　滚轮缩放　暂停后可逐帧检查</div><div id="story"><h3 id="stageTitle">正在准备</h3><p id="stageFocus">读取行为谱、动作依赖图和表面。</p><div id="phaseRail"></div><div class="minirow"><span id="headInfo"></span><span id="clawInfo"></span><span id="tailInfo"></span></div></div><div id="loading">正在展开表面并检查绑定…</div></div><aside>
<section><h2>空中生活状态 / 每组是完整活动链</h2><div id="scenarios"></div><label class="row"><input type="checkbox" id="autoplay" checked>四种状态连续试演</label><div class="meta">可随时切换状态：保存当前姿态后平滑过渡，不重新摆回绑定。</div></section>
<section><div class="row spread"><button id="toggle">暂停</button><button id="reset">静态绑定</button><span class="pill" id="fps"></span></div><div class="row spread"><span>逐帧检查</span><span class="pill" id="timeLabel"></span></div><input type="range" id="time" min="0" max="16" step=".01" value="0"><div id="phaseButtons"></div><label class="row">播放速度<input id="speed" type="range" min=".25" max="1.5" step=".05" value="1"></label></section>
<section><h2>联动分层对照</h2><label class="row"><input type="checkbox" id="life" checked>生活层：观察、伸足、张趾与恢复</label><label class="row"><input type="checkbox" id="coupled" checked>身体层：胸腹、尾、腿的连动</label><label class="row"><input type="checkbox" id="stabilize" checked>头颈反向补偿</label><div class="meta">开关用于同一翼周期下的 A/B 检查，修改写入当前动作谱。</div><div id="signals"></div></section>
<section><h2>游戏输入 / 打断当前活动</h2><div class="grid two"><button id="target">前方水面目标</button><button id="threat">侧后方干扰</button><button id="wind">阵风到达</button><button id="resume">回到巡航</button></div><div class="meta">这是明确事件输入，不是自动识别画面。接近目标后演示放弃与恢复，不虚构抓鱼成功。</div></section>
<section><h2>相机</h2><div class="grid" id="views"><button data-view="three" class="active">三分之四</button><button data-view="front">正面</button><button data-view="back">背面</button><button data-view="left">左侧</button><button data-view="right">右侧</button><button data-view="top">俯视</button><button data-view="head">头颈</button><button data-view="feet">脚爪</button><button data-view="feather">修复羽缘</button></div></section>
<details><summary>表面与绑定检查</summary><div class="grid two"><button data-mode="0" class="active">来源色彩</button><button data-mode="1">白模</button><button data-mode="2">运动区域</button><button data-mode="4">绑定权重</button></div><label class="row"><input id="bones" type="checkbox">显示控制骨架</label><select id="region"><option value="-1">全部区域</option></select><label class="row"><input id="isolate" type="checkbox">隔离所选区域</label><div class="meta" id="stats"></div></details>
<details><summary>R05 单动作回归</summary><div class="grid two" id="oldClips"></div></details>
<section><button class="wide" id="exportMotion">导出当前动作 / 生活谱</button><button class="wide" id="importMotion" style="margin-top:6px">导入兼容谱</button><input type="file" id="file" accept=".kscore,.json" hidden><div class="note" id="error"></div></section>
<div class="note">本轮是空中生活片段。脚爪采用连续表面趾组控制，不等于逐趾解剖或真实抓握；未开放停栖、完全收翼与接触捕获。来源模型与真实成鸟尺度未统一。</div><div class="footer">23 个控制关节 · 120 Hz 固定步长 · 生活意图 + 翼周期 + 二阶响应。<br>仍携带来源表面数据，不宣称纯规则外形生成。局部羽尖重采样保留源边界连接。</div>
</aside></main><script>/* KAOPU connected-surface / quaternion instrument 4.0.
 * Generic execution only. Shape, regions, pivots, limits and motion live in scores.
 * This is NOT an anatomical generative model. It reconstructs a source-derived surface.
 */
(function(G){'use strict';
const MAXB=32;
const clamp=(x,a,b)=>Math.min(b,Math.max(a,x));
const dot=(a,b)=>a.reduce((s,v,i)=>s+v*b[i],0);
const cross=(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];
const add=(a,b)=>a.map((v,i)=>v+b[i]);
const sub=(a,b)=>a.map((v,i)=>v-b[i]);
const norm=a=>{let l=Math.hypot(...a);if(l<1e-12)throw Error('Zero vector/quaternion');return a.map(x=>x/l)};
const qmul=(a,b)=>[a[3]*b[0]+a[0]*b[3]+a[1]*b[2]-a[2]*b[1],a[3]*b[1]-a[0]*b[2]+a[1]*b[3]+a[2]*b[0],a[3]*b[2]+a[0]*b[1]-a[1]*b[0]+a[2]*b[3],a[3]*b[3]-a[0]*b[0]-a[1]*b[1]-a[2]*b[2]];
const qrot=(q,v)=>{let u=q.slice(0,3),t=cross(u,v).map(x=>2*x),k=cross(u,t);return v.map((x,i)=>x+q[3]*t[i]+k[i])};
function slerp(a,b,t){let d=dot(a,b);if(d<0){b=b.map(x=>-x);d=-d}if(d>.9995)return norm(a.map((x,i)=>x+(b[i]-x)*t));let th=Math.acos(clamp(d,-1,1)),ss=Math.sin(th);return a.map((x,i)=>(x*Math.sin((1-t)*th)+b[i]*Math.sin(t*th))/ss)}
const ease=t=>t*t*t*(10+t*(-15+6*t));
function validateSpecies(s){if(s.schema!=='kaopu/connected-surface-rig@4.0')throw Error('Unsupported surface schema');let b=s.rig.bones;if(!b.length||b.length>MAXB)throw Error('Joint budget');const ids=new Set();for(let i=0;i<b.length;i++){let x=b[i];if(ids.has(x.id)||x.parent>=i||x.parent< -1||x.pivot.length!==3||!x.pivot.every(Number.isFinite))throw Error('Invalid bind hierarchy');ids.add(x.id)}if(s.representation.vertices>s.limits.max_vertices||s.representation.triangles>s.limits.max_triangles)throw Error('Surface budget');return true}
function validateMotion(m,s){if(m?.schema==='kaopu/coupled-motion@5.0')return G.KaopuMotion.validate(m,s);if(!m||typeof m!=='object'||!m.clips||typeof m.clips!=='object'||Array.isArray(m.clips)||!m.clips.bind||Object.keys(m.clips).length>64||!Number.isFinite(m.transition_seconds)||m.transition_seconds<0||m.transition_seconds>5)throw Error('Invalid motion catalogue');if(m.schema!=='kaopu/quaternion-motion@4.0'||m.rig_revision!==s.revision)throw Error('Motion/bind version mismatch');let ids=new Set(s.rig.bones.map(b=>b.id));for(let [id,c] of Object.entries(m.clips)){if(!c||!Array.isArray(c.tracks)||c.tracks.length>s.rig.bones.length||typeof c.loop!=='boolean')throw Error('Invalid clip tracks');if(!(c.duration>0&&c.duration<=600))throw Error('Invalid duration '+id);let seen=new Set();for(let tr of c.tracks){if(!ids.has(tr.joint)||tr.channel!=='rotation'||tr.interpolation!=='slerp-quintic'||seen.has(tr.joint))throw Error('Unsupported/duplicate motion channel');seen.add(tr.joint);if(!Array.isArray(tr.times)||!Array.isArray(tr.values)||tr.times.length!==tr.values.length||tr.times.length<2||tr.times.length>4096)throw Error('Invalid track size');for(let i=0;i<tr.times.length;i++){if(!Number.isFinite(tr.times[i])||tr.times[i]<0||tr.times[i]>c.duration||(i>0&&tr.times[i]<=tr.times[i-1]))throw Error('Unsorted keyframes');let q=tr.values[i];if(!Array.isArray(q)||q.length!==4||!q.every(Number.isFinite)||Math.abs(Math.hypot(...q)-1)>1e-5)throw Error('Invalid quaternion')}if(tr.times[0]!==0||Math.abs(tr.times.at(-1)-c.duration)>1e-6)throw Error('Track must span the clip');if(c.loop&&Math.abs(dot(tr.values[0],tr.values.at(-1)))<1-1e-6)throw Error('Loop endpoints do not match')}}return true}
function samplePose(s,m,id,time){if(m.schema==='kaopu/coupled-motion@5.0')return new G.KaopuMotion.Sampler(s,m,id).sample(time);let c=m.clips[id];if(!c)throw Error('Unknown motion: '+id);let t=c.loop?((time%c.duration)+c.duration)%c.duration:clamp(time,0,c.duration);let q=s.rig.bones.map(()=>[0,0,0,1]);const map=new Map(s.rig.bones.map((b,i)=>[b.id,i]));for(let tr of c.tracks){let a=0;while(a<tr.times.length-2&&tr.times[a+1]<t)a++;let u=clamp((t-tr.times[a])/(tr.times[a+1]-tr.times[a]),0,1);q[map.get(tr.joint)]=slerp(tr.values[a],tr.values[a+1],ease(u))}return{rotations:q,root:[0,0,0]}}
function constrainPose(s,pose){return{root:pose.root.slice(),rotations:pose.rotations.map((q,i)=>{q=norm(q);if(q[3]<0)q=q.map(v=>-v);let a=2*Math.acos(clamp(q[3],-1,1)),max=s.rig.bones[i].max_angle_deg*Math.PI/180;return a>max?slerp([0,0,0,1],q,max/a):q})}}
function makeRig(s,pose){const worldQ=[],worldP=[],real=new Float32Array(MAXB*4),dual=new Float32Array(MAXB*4);for(let i=0;i<MAXB;i++)real[i*4+3]=1;const bs=s.rig.bones;for(let i=0;i<bs.length;i++){let b=bs[i],pa=b.parent,q=pose.rotations[i];if(pa<0){worldQ[i]=q;worldP[i]=add(b.pivot,pose.root)}else{worldQ[i]=norm(qmul(worldQ[pa],q));worldP[i]=add(worldP[pa],qrot(worldQ[pa],sub(b.pivot,bs[pa].pivot)))}let rot=worldQ[i],t=sub(worldP[i],qrot(rot,b.pivot)),du=qmul([...t,0],rot).map(x=>x*.5);real.set(rot,i*4);dual.set(du,i*4)}return{worldQ,worldP,real,dual}}
function deformPoint(p,j,w,rig){let ref=Array.from(rig.real.subarray(j[0]*4,j[0]*4+4)),r=[0,0,0,0],d=[0,0,0,0];for(let a=0;a<4;a++){let q=Array.from(rig.real.subarray(j[a]*4,j[a]*4+4)),du=Array.from(rig.dual.subarray(j[a]*4,j[a]*4+4)),sg=dot(ref,q)<0?-1:1;for(let k=0;k<4;k++){r[k]+=q[k]*w[a]*sg;d[k]+=du[k]*w[a]*sg}}let l=Math.hypot(...r);r=r.map(x=>x/l);d=d.map(x=>x/l);let orth=dot(r,d);d=d.map((x,i)=>x-r[i]*orth);let t=qmul(d,[-r[0],-r[1],-r[2],r[3]]).slice(0,3).map(x=>2*x);return add(qrot(r,p),t)}
const VS=`precision highp float;
attribute vec3 aPosition;attribute vec3 aNormal;attribute vec3 aColor;attribute vec4 aJoints;attribute vec4 aWeights;attribute float aRegion;
uniform mat4 uVP;uniform vec4 uReal[32];uniform vec4 uDual[32];uniform vec3 uPalette[16];uniform float uHighlight;varying vec3 vRegionColor;varying float vSelected;varying vec3 vWorld;varying vec3 vNormal;varying vec3 vColor;varying float vRegion;varying float vWeight;
vec3 qr(vec4 q,vec3 p){return p+2.*cross(q.xyz,cross(q.xyz,p)+q.w*p);}
void main(){ivec4 j=ivec4(aJoints+.5);vec4 r0=uReal[j.x],r1=uReal[j.y],r2=uReal[j.z],r3=uReal[j.w];vec4 d0=uDual[j.x],d1=uDual[j.y],d2=uDual[j.z],d3=uDual[j.w];float s1=dot(r0,r1)<0.?-1.:1.,s2=dot(r0,r2)<0.?-1.:1.,s3=dot(r0,r3)<0.?-1.:1.;vec4 r=r0*aWeights.x+r1*aWeights.y*s1+r2*aWeights.z*s2+r3*aWeights.w*s3;vec4 d=d0*aWeights.x+d1*aWeights.y*s1+d2*aWeights.z*s2+d3*aWeights.w*s3;float le=length(r);r/=le;d/=le;d-=r*dot(r,d);vec3 tr=2.*(r.w*d.xyz-d.w*r.xyz+cross(r.xyz,d.xyz));vec3 p=qr(r,aPosition)+tr;vWorld=p;vNormal=normalize(qr(r,aNormal));vColor=aColor;vRegionColor=uPalette[int(aRegion+.5)];vSelected=abs(aRegion-uHighlight)<.5?1.:0.;vRegion=aRegion;vWeight=max(max(aWeights.x,aWeights.y),max(aWeights.z,aWeights.w));gl_Position=uVP*vec4(p,1.);}`;
const FS=`precision highp float;varying vec3 vRegionColor;varying float vSelected;varying vec3 vWorld;varying vec3 vNormal;varying vec3 vColor;varying float vRegion;varying float vWeight;uniform vec3 uEye;uniform int uMode;uniform float uHighlight;uniform float uIsolate;uniform vec4 uEyeL;uniform vec4 uEyeR;uniform vec3 uEyeLForward;uniform vec3 uEyeRForward;uniform vec3 uEyeUp;uniform vec3 uIrisColor;uniform vec3 uPupilColor;uniform vec3 uRingColor;uniform vec3 uBeakUpper;uniform vec3 uBeakLower;uniform vec3 uBeakNostril;
vec3 shadeEye(vec3 center,vec3 fwd,vec3 N,vec3 V,vec3 L,vec3 R){vec3 dir=normalize(vWorld-center);vec3 Fw=normalize(fwd);vec3 Up=normalize(uEyeUp);vec3 Rt=normalize(cross(Up,Fw));Up=normalize(cross(Fw,Rt));float ex=dot(dir,Rt),ey=dot(dir,Up),rr=length(vec2(ex,ey));vec3 col=mix(vec3(.56,.53,.42),uIrisColor,smoothstep(.78,.24,rr));col=mix(col,uRingColor,smoothstep(.58,.34,rr)*smoothstep(.10,.24,rr));col=mix(col,uPupilColor,1.-smoothstep(.12,.22,rr));float lid=smoothstep(.18,.95,dir.z);col*=mix(.80,1.0,lid)*(1.0-0.12*smoothstep(0.0,0.5,ey));float catch1=exp(-((ex+.13)*(ex+.13)+(ey-.11)*(ey-.11))*180.);float catch2=exp(-((ex-.07)*(ex-.07)+(ey+.02)*(ey+.02))*300.);float gloss=pow(max(dot(reflect(-L,N),V),0.),90.)*.18+pow(max(dot(reflect(-R,N),V),0.),120.)*.12;col+=vec3(catch1*.55+catch2*.22+gloss);return col;}
void main(){int region=int(floor(vRegion+.5));if(uIsolate>.5&&uHighlight>=0.&&vSelected<.5)discard;vec3 N=normalize(vNormal);if(!gl_FrontFacing)N=-N;vec3 V=normalize(uEye-vWorld);vec3 L=normalize(vec3(.35,.70,.60)),F=normalize(vec3(-.62,.34,.30)),R=normalize(vec3(.12,.50,-.65));vec3 al=vColor;float rough=.76;if(uMode==1)al=vec3(.74,.73,.69);if(uMode==2)al=vRegionColor;if(uMode==3){gl_FragColor=vec4(N*.5+.5,1.);return;}if(uMode==4)al=mix(vec3(.15,.35,.80),vec3(.9,.33,.15),1.-vWeight);if(region==1){float under=smoothstep(.176,.205,vWorld.z)*(1.0-smoothstep(.186,.197,vWorld.y))*smoothstep(-.002,.006,vWorld.x)*(1.0-smoothstep(.031,.04,vWorld.x));al=mix(al,uBeakLower*vec3(.96,.95,.92),under*.9);}if(region==2||region==3){vec3 base=region==2?uBeakUpper:uBeakLower;float tip=smoothstep(.165,.222,vWorld.z);float top=smoothstep(.165,.218,vWorld.y);al=mix(base*vec3(.82,.84,.84),base*vec3(1.06,1.04,1.0),tip);al*=mix(.94,1.03,top);if(region==2){float nost=exp(-(pow((vWorld.x-.016)/.008,2.)+pow((vWorld.y-.205)/.007,2.)+pow((vWorld.z-.189)/.012,2.)));al=mix(al,uBeakNostril,nost*.72);}rough=.34;}float hemi=.82+.18*N.y;float light=.40+.67*max(dot(N,L),0.)+.28*max(dot(N,F),0.)+.13*max(dot(N,R),0.);vec3 H=normalize(L+V);float spec=pow(max(dot(N,H),0.),35.)*(region==4 ? .08 : ((region==2||region==3) ? .028 : .016));vec3 col=pow(max(pow(al,vec3(2.2))*light*hemi+spec,0.),vec3(1./2.2));if(region==4){float dL=distance(vWorld,uEyeL.xyz),dR=distance(vWorld,uEyeR.xyz);col=dL<dR?shadeEye(uEyeL.xyz,uEyeLForward,N,V,L,R):shadeEye(uEyeR.xyz,uEyeRForward,N,V,L,R);}if(uHighlight>=0.&&vSelected>.5)col=mix(col,vec3(1.,.61,.16),.36);gl_FragColor=vec4(col,1.);}`;
const LVS=`precision highp float;attribute vec3 aPosition;uniform mat4 uVP;void main(){gl_Position=uVP*vec4(aPosition,1.);gl_PointSize=5.;}`;
const LFS=`precision highp float;uniform vec4 uColor;void main(){gl_FragColor=uColor;}`;
function mm(a,b){let o=new Float32Array(16);for(let c=0;c<4;c++)for(let r=0;r<4;r++)for(let k=0;k<4;k++)o[c*4+r]+=a[k*4+r]*b[c*4+k];return o}
function persp(f,asp,n,fa){let h=1/Math.tan(f/2);return new Float32Array([h/asp,0,0,0,0,h,0,0,0,0,(fa+n)/(n-fa),-1,0,0,2*fa*n/(n-fa),0])}
function look(e,t){let z=norm(sub(e,t)),x=norm(cross([0,1,0],z)),y=cross(z,x);return new Float32Array([x[0],y[0],z[0],0,x[1],y[1],z[1],0,x[2],y[2],z[2],0,-dot(x,e),-dot(y,e),-dot(z,e),1])}
