"};
const $=id=>document.getElementById(id);let player,playlist=[];
function save(n,t){const u=URL.createObjectURL(new Blob([t],{type:'application/json'})),a=document.createElement('a');a.href=u;a.download=n;a.click();setTimeout(()=>URL.revokeObjectURL(u),2000)}
function update(e){const st=e.behaviorSnapshot(),c=e.motion.clips[e.action],v=e.signals||{};const f=(k,n=1)=>(v[k]||0).toFixed(n);$('stageTitle').textContent=st.stage;$('stageFocus').textContent=st.focus||'静态或单动作回归检查';$('time').value=st.time;$('timeLabel').textContent=st.time.toFixed(2)+' / '+st.duration.toFixed(1)+' s';$('fps').textContent=e.playing?e.fps.toFixed(1)+' fps':'暂停';$('toggle').textContent=e.playing?'暂停':'播放';$('headInfo').textContent='注意方向 '+f('gaze_yaw')+'° / '+f('gaze_pitch')+'°';$('clawInfo').textContent='伸足 '+((v.reach_L||0)*100).toFixed(0)+'% · 趾组 '+f('toe_front_L')+'°';$('tailInfo').textContent='尾部响应 '+((v.tail_pitch||0)+(v.tail_brake||0)).toFixed(1)+'°';$('signals').textContent=`肩 → 肘 → 腕 → 翼端\n${f('drive',2)} / ${f('elbow_follow',2)} / ${f('wrist_follow',2)} / ${f('hand_follow',2)}\n头颈 ${f('neck_turn')}° / 注视 ${f('gaze_yaw')}°\n左 / 右伸足 ${f('reach_L',2)} / ${f('reach_R',2)}`;document.querySelectorAll('#phaseRail span').forEach((x,i)=>x.classList.toggle('on',!!c.phases?.[i]&&st.time>=c.phases[i].start&&st.time<c.phases[i].end));}
function transport(e){const c=e.motion.clips[e.action];$('time').max=c.duration;$('phaseRail').innerHTML='';$('phaseButtons').innerHTML='';for(const st of c.phases||[]){let x=document.createElement('span');x.style.flex=(st.end-st.start);$('phaseRail').appendChild(x);let b=document.createElement('button');b.textContent=st.label;b.onclick=()=>{e.seek(st.start+.05);update(e)};$('phaseButtons').appendChild(b)}document.querySelectorAll('[data-action]').forEach(x=>x.classList.toggle('active',x.dataset.action===e.action));update(e)}
function start(e,id,manual=true){if(manual)$('autoplay').checked=false;if(e.motion.clips[id].life_state)e.triggerBehavior(id);else{e.worldInputs={};e.setAction(id)}transport(e);}
function catalogue(e){$('scenarios').innerHTML='';$('oldClips').innerHTML='';playlist=e.motion.behaviors?.playlist||Object.keys(e.motion.clips).filter(k=>e.motion.clips[k].life_state);for(const[id,c]of Object.entries(e.motion.clips)){if(id==='bind')continue;const b=document.createElement('button');b.dataset.action=id;b.textContent=c.label;if(c.life_state){const detail=document.createElement('span');detail.textContent=c.phases.map(p=>p.label).join(' → ');b.appendChild(detail)}b.onclick=()=>start(e,id);$(c.life_state?'scenarios':'oldClips').appendChild(b)}}
(async()=>{let t=performance.now();const e=player=new KaopuSurface.Player($('view'),SPECIES,MOTION,BLOBS,{onUpdate:e=>update(e),onCycle:e=>{if($('autoplay').checked&&playlist.includes(e.action)){start(e,playlist[(playlist.indexOf(e.action)+1)%playlist.length],false);return true}return false}});await e.init();window.eagle=e;catalogue(e);$('loading').style.display='none';$('stats').textContent=e.positions.length/3+' 顶点 / '+e.indices.length/3+' 三角面；'+SPECIES.rig.bones.length+' 控制关节。载入 '+((performance.now()-t)/1000).toFixed(2)+' s。';
$('toggle').onclick=()=>{e.playing=!e.playing;e.last=performance.now();update(e)};$('reset').onclick=()=>{$('autoplay').checked=false;e.worldInputs={};e.setAction('bind');e.seek(0);transport(e)};$('time').oninput=()=>{e.seek(+$('time').value);update(e)};$('speed').oninput=()=>e.speed=+$('speed').value;
for(const[id,key,val]of[['life','life_gain',1],['coupled','coupling_gain',1],['stabilize','head_stability',.95]])$(id).onchange=()=>{e.setControl(key,$(id).checked?val:0);update(e)};
for(const[id,state]of[['target','approach'],['threat','alert'],['wind','gust'],['resume','patrol']])$(id).onclick=()=>start(e,state);
for(const b of document.querySelectorAll('[data-view]'))b.onclick=()=>{e.setView(b.dataset.view);document.querySelectorAll('[data-view]').forEach(x=>x.classList.toggle('active',x===b))};for(const b of document.querySelectorAll('[data-mode]'))b.onclick=()=>{e.setMode(+b.dataset.mode);document.querySelectorAll('[data-mode]').forEach(x=>x.classList.toggle('active',x===b))};$('bones').onchange=()=>{e.showBones=$('bones').checked;e.dirty=true};for(const r of SPECIES.regions){const o=document.createElement('option');o.value=r.id;o.textContent=r.label;$('region').appendChild(o)};$('region').onchange=()=>{e.highlight=+$('region').value;e.dirty=true};$('isolate').onchange=()=>{e.isolate=$('isolate').checked;e.dirty=true};
$('exportMotion').onclick=()=>save('BALD_EAGLE_R07.motion.kscore',JSON.stringify(e.motion,null,2));$('importMotion').onclick=()=>$('file').click();$('file').onchange=async ev=>{try{const f=ev.target.files[0];if(!f)return;if(f.size>500000)throw Error('超出谱文件预算');const m=JSON.parse(await f.text());KaopuSurface.validateMotion(m,SPECIES);e.motion=m;e.controlValues={};e.worldInputs={};e.setAction('bind');e.seek(0);catalogue(e);transport(e);for(const[id,key]of[['life','life_gain'],['coupled','coupling_gain'],['stabilize','head_stability']])$(id).checked=(m.controls[key]?.value??0)>0;$('error').style.display='none'}catch(err){$('error').textContent='未载入：'+err.message+'。保留上一份有效谱。';$('error').style.display='block'}};
window.__READY__=true;window.__LOAD_MS__=performance.now()-t;window.__UI_UPDATE__=()=>transport(e);start(e,e.motion.behaviors.default,false);
})().catch(err=>{console.error(err);$('loading').textContent='载入失败：'+err.message});
</script></body></html>
