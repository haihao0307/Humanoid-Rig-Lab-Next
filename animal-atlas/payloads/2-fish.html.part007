  float j=(uSchool?local.x:uJaw)*aW0.z;vec3 q=p-uJawPivot;p=uJawPivot+vec3(cos(j)*q.x-sin(j)*q.y,sin(j)*q.x+cos(j)*q.y,q.z);n=rotateAxis(n,vec3(0,0,1),j);
