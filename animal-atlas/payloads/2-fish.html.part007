function readScore(){const node=document.getElementById("fishData"),alphabet="!#$%()*+,-./0123456789:;=?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_abcdefghijklmnopqrstuvwxyz{|",length=+node.dataset.bytes,map=new Uint8Array(128),out=new Uint8Array(length);let text=node.textContent;node.remove();for(let i=0;i<alphabet.length;i++)map[alphabet.charCodeAt(i)]=i;let o=0;for(let i=0;i<text.length;i+=5){let v=0;for(let k=0;k<5;k++)v=v*85+map[text.charCodeAt(i+k)];for(let k=3;k>=0;k--){if(o+k<length)out[o+k]=v%256;v=Math.floor(v/256);}o+=4;}text="";return out;}
function compileShader(gl,type,source){const sh=gl.createShader(type);gl.shaderSource(sh,source);gl.compileShader(sh);if(!gl.getShaderParameter(sh,gl.COMPILE_STATUS)){const log=gl.getShaderInfoLog(sh);gl.deleteShader(sh);throw Error('Shader compile failed: '+log);}return sh;}
