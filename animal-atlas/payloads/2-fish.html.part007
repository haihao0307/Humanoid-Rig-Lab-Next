out vec4 outColor;
vec3 toLinear(vec3 c){return mix(c/12.92,pow((c+.055)/1.055,vec3(2.4)),step(vec3(.04045),c));}
vec3 toSRGB(vec3 c){return mix(c*12.92,1.055*pow(max(c,0.0),vec3(1.0/2.4))-.055,step(vec3(.0031308),c));}
float weight(int i){if(i==0)return vW0.x;if(i==1)return vW0.y;if(i==2)return vW0.z;if(i==3)return vW0.w;if(i==4)return vW1.x;if(i==5)return vW1.y;if(i==6)return vW1.z;if(i==7)return vW1.w;if(i==8)return vW2.x;if(i==9)return vW2.y;if(i==10)return vW2.z;if(i==11)return vW2.w;return 0.0;}
float response(int i){if(i==0)return uResponse0.x;if(i==1)return uResponse0.y;if(i==2)return uResponse0.z;if(i==3)return uResponse0.w;if(i==4)return uResponse1.x;if(i==5)return uResponse1.y;if(i==6)return uResponse1.z;if(i==7)return uResponse1.w;if(i==8)return uResponse2.x;if(i==9)return uResponse2.y;if(i==10)return uResponse2.z;if(i==11)return uResponse2.w;return 0.0;}
vec3 heat(float x){x=clamp(x,0.0,1.0);return clamp(vec3(1.5-abs(4.0*x-3.0),1.5-abs(4.0*x-2.0),1.5-abs(4.0*x-1.0)),0.0,1.0);}
vec3 weightComposite(){vec3 c=vec3(0);float s=0.0;for(int i=5;i<12;i++){float w=weight(i);vec3 k=i==0?vec3(.15,.75,1.0):i==1?vec3(.75,.95,1.0):i==2?vec3(1,.32,.12):i==3?vec3(.2,1,.65):i==4?vec3(1,.72,.15):i==5?vec3(.15,.85,.95):i==6?vec3(.75,.35,1):i==7?vec3(1,.18,.55):i==8?vec3(.95,.55,.12):i==9?vec3(.2,.85,.2):i==10?vec3(.1,.55,1):vec3(1,.85,.1);c+=w*k;s+=w;}return c/max(s,.0001);}
vec3 mappedNormal(){vec3 N=normalize(vNormal);if(uNormalMap&&uMode==0){vec3 dx=dFdx(vViewPos),dy=dFdy(vViewPos);vec2 tx=dFdx(vUv),ty=dFdy(vUv);float det=tx.x*ty.y-tx.y*ty.x;if(abs(det)>1e-12){vec3 T=(dx*ty.y-dy*tx.y)*sign(det),rawB=(-dx*ty.x+dy*tx.x)*sign(det);T=normalize(T-N*dot(N,T));vec3 B=normalize(cross(N,T));if(dot(B,rawB)<0.0)B=-B;vec3 sampleN=texture(uNormal,vUv).xyz*2.0-1.0;N=normalize(mat3(T,B,N)*sampleN);}}return gl_FrontFacing?N:-N;}
void main(){
 vec3 tex=texture(uBase,vUv).rgb;float gray=dot(tex,vec3(.2126,.7152,.0722));tex=mix(vec3(gray),tex,vTint.w);tex=clamp(mix(gray*vec3(.92,1.0,1.075),tex,.28)*vTint.rgb,0.0,1.0);float eyeMask=smoothstep(.26,.88,vW1.x);tex=mix(tex,vec3(.055,.065,.06),eyeMask*.92);
 if(uMode==4){outColor=vec4(tex,1);return;}if(uMode==3){outColor=vec4(fract(vUv),.25,1);return;}if(uMode==5){outColor=vec4(weightComposite(),1);return;}if(uMode==6){outColor=vec4(heat(weight(uWeightChannel)),1);return;}if(uMode==7){outColor=vec4(mix(vec3(.025,.035,.04),vec3(1,.65,.13),eyeMask),1);return;}if(uMode==8){float a=0.0;for(int i=5;i<12;i++)a+=weight(i)*response(i);outColor=vec4(heat(clamp(a*.72,0.0,1.0)),1);return;}
 vec3 N=mappedNormal();if(uMode==2){outColor=vec4(N*.5+.5,1);return;}vec3 base=uMode==1?vec3(.56):toLinear(tex),rm=texture(uRm,vUv).rgb;float rough=uMode==1?.66:clamp(rm.g,.18,.98),metal=uMode==1?0.0:clamp(rm.b,0.,1.);vec3 L=normalize(vec3(-.4,.75,.8)),L2=normalize(vec3(.7,.3,-.45)),V=normalize(-vViewPos);float diff=max(dot(N,L),0.),fill=max(dot(N,L2),0.),spec=pow(max(dot(N,normalize(V+L)),0.),mix(110.,7.,rough));vec3 lit=base*(.38+.58*diff+.22*fill)+mix(vec3(.028),base,metal)*spec*(1.-rough)*.8;outColor=vec4(toSRGB(clamp(lit,0.,1.)),1);
}`;
const EYE_VERTEX=`#version 300 es
precision highp float;precision highp int;
layout(location=0) in vec3 aPosition;layout(location=1) in vec3 aNormal;layout(location=2) in uint aComponent;layout(location=3) in vec2 aUv;
uniform mat4 uMvp,uView,uModel;uniform mat3 uModelNormal;uniform vec3 uCenter,uTangent,uUp,uOutward;uniform float uGazeYaw,uGazePitch,uPupil,uGlobeRadius;
out vec3 vNormal,vViewPos,vLocal;out vec2 vUv;flat out uint vComponent;
void main(){vec3 local=aPosition,n=aNormal;if(aComponent==2u||aComponent==3u){vec3 dir=normalize(vec3(sin(uGazeYaw),sin(uGazePitch),cos(uGazeYaw)*cos(uGazePitch)));vec3 gx=normalize(vec3(cos(uGazeYaw),0.0,-sin(uGazeYaw)));vec3 gy=normalize(cross(dir,gx));float scale=aComponent==3u?mix(.78,1.34,clamp(uPupil,0.0,1.0)):1.0;float lx=aPosition.x*scale,ly=aPosition.y*scale,lz=sqrt(max(uGlobeRadius*uGlobeRadius-lx*lx-ly*ly,0.0))+(aComponent==3u?.00032:.00022);local=dir*lz+gx*lx+gy*ly;n=normalize(dir*lz+gx*lx+gy*ly);}vec3 world=uCenter+uTangent*local.x+uUp*local.y+uOutward*local.z;vec3 wn=normalize(uTangent*n.x+uUp*n.y+uOutward*n.z);world=(uModel*vec4(world,1)).xyz;wn=normalize(uModelNormal*wn);vNormal=normalize(mat3(uView)*wn);vViewPos=(uView*vec4(world,1)).xyz;vLocal=local;vUv=aUv;vComponent=aComponent;gl_Position=uMvp*vec4(world,1);}`;
const EYE_FRAGMENT=`#version 300 es
