  axialStep(s.body,axialTargets(h,p,f,drive),r.body,dt);axialStep(s.pitch,new Float64Array(r.body.nodes).fill(f.pitch*drive),r.body,dt);sampleFields(h,true);s.peduncle=peduncleMotion(h,dt);
  for(const part of r.parts){let base;if(part.id<=2)base=(f.fin+(part.id===1?1:-1)*(p.differential||0))*drive;else if(part.id===7)base=mode==='FIN_FAN'?f.fin*drive:clamp(-r.axialGait.caudalAngleGain*s.peduncle.angle-r.axialGait.caudalVelocitySeconds*s.peduncle.angularVelocity,-.45,.45);else base=(f.fin*.56+f.body*.18)*drive;const channel=part.id+4,target=clamp(base*s.response[channel],-r.axialGait.finDriveLimitRad,r.axialGait.finDriveLimitRad);if(part.id===7)s.caudalInput=target;chainStep(s.parts[part.id],target,part.dynamics,dt);}
