vec4 field(int row,float t){float f=clamp(t,0.0,1.0)*float(uSamples-1);int i=int(floor(f));return mix(texelFetch(uField,ivec2(i,row+9*(uSchool?gl_InstanceID:uPoseIndex)),0),texelFetch(uField,ivec2(min(i+1,uSamples-1),row+9*(uSchool?gl_InstanceID:uPoseIndex)),0),fract(f));}
vec3 octNormal(vec2 e){vec3 n=vec3(e,1.0-abs(e.x)-abs(e.y));if(n.z<0.0)n.xy=(1.0-abs(n.yx))*sign(n.xy+1e-8);return normalize(n);}
vec3 rotateAxis(vec3 n,vec3 axis,float a){return n*cos(a)+cross(axis,n)*sin(a)+axis*dot(axis,n)*(1.0-cos(a));}
float partWeight(uint id){if(id==1u)return aW1.y;if(id==2u)return aW1.z;if(id==3u)return aW1.w;if(id==4u)return aW2.x;if(id==5u)return aW2.y;if(id==6u)return aW2.z;if(id==7u)return aW2.w;return 0.0;}
