function reset(h,mode='REST',options={}){if(!h.metadata.motion.modes[mode])throw Error('Unknown motion '+mode);h.state=newState(h.metadata,mode,options);sampleFields(h);h.state.tailTipPosition=deformPoint(h,h.metadata.continuum.axialGait.caudalTipVertex);return h.state;}
function setMode(h,mode,options={}){if(!h.metadata.motion.modes[mode])throw Error('Unknown motion '+mode);if(h.state.mode!==mode){h.state.mode=mode;h.state.modeTime=0;}return h.state;}
function forcing(mode,p,t,phase){
