 let ey=p.eyeYaw||0,ep=p.eyePitch||0;if(mode==='EYE_TRACK'){ey*=Math.sin(TAU*.18*t);ep*=Math.sin(TAU*.13*t+.7);}else if(mode!=='REST'){ey+=.018*Math.sin(TAU*.21*t);ep+=.010*Math.sin(TAU*.17*t+.4);}
