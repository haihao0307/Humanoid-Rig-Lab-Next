class OrbitCamera{
 constructor(canvas){this.canvas=canvas;this.target=[0,.14,0];this.yaw=-.45;this.pitch=.75;this.zoom=1;this.distance=1.55;this.upMode='Y';this.drag=null;canvas.addEventListener('contextmenu',e=>e.preventDefault());canvas.addEventListener('pointerdown',e=>{if(this.interactionOwns?.(e))return;canvas.setPointerCapture(e.pointerId);this.drag={x:e.clientX,y:e.clientY,button:e.button,shift:e.shiftKey};});canvas.addEventListener('pointermove',e=>{if(!this.drag)return;const dx=e.clientX-this.drag.x,dy=e.clientY-this.drag.y;this.drag.x=e.clientX;this.drag.y=e.clientY;if(this.drag.button===2||this.drag.shift)this.pan(dx,dy);else{this.yaw-=dx*.006;this.pitch=clamp(this.pitch-dy*.006,-1.54,1.54);this.upMode='Y';}});const clear=()=>this.drag=null;canvas.addEventListener('pointerup',clear);canvas.addEventListener('pointercancel',clear);canvas.addEventListener('wheel',e=>{e.preventDefault();this.zoom=clamp(this.zoom*Math.exp(-e.deltaY*.0012),.45,15);},{passive:false});}
 eye(){const cp=Math.cos(this.pitch);return [this.target[0]+this.distance*cp*Math.sin(this.yaw),this.target[1]+this.distance*Math.sin(this.pitch),this.target[2]+this.distance*cp*Math.cos(this.yaw)];}
 up(){return this.upMode==='NEG_Z'?[0,0,-1]:this.upMode==='POS_Z'?[0,0,1]:[0,1,0];}
 matrices(aspect){const eye=this.eye(),view=mat4LookAt(eye,this.target,this.up()),halfW=(this.halfWidth||.58)/this.zoom,halfH=halfW/Math.max(aspect,.05);return{view,projection:mat4Ortho(-halfW,halfW,-halfH,halfH,.01,20),eye};}
 mvp(aspect){const m=this.matrices(aspect);return{...m,mvp:mat4Multiply(m.projection,m.view)};}
 pan(dx,dy){const eye=this.eye(),f=normalize3([this.target[0]-eye[0],this.target[1]-eye[1],this.target[2]-eye[2]]),right=normalize3(cross3(f,this.up())),up=cross3(right,f),s=.0011/this.zoom;for(let i=0;i<3;i++)this.target[i]+=(-dx*right[i]+dy*up[i])*s;}
 setView(id){this.upMode='Y';this.zoom=1;if(id==='left'){this.yaw=0;this.pitch=0;}else if(id==='right'){this.yaw=Math.PI;this.pitch=0;}else if(id==='head'){this.yaw=-Math.PI/2;this.pitch=0;this.zoom=1.25;}else if(id==='tail'){this.yaw=Math.PI/2;this.pitch=0;this.zoom=1.25;}else if(id==='top'){this.yaw=0;this.pitch=Math.PI/2-.0001;this.upMode='NEG_Z';}else if(id==='bottom'){this.yaw=0;this.pitch=-Math.PI/2+.0001;this.upMode='POS_Z';}else{this.yaw=-.72;this.pitch=.23;}this.target=[0,.14,0];}
