  if(pid>0u&&pid<=7u){float t=float(aPartInfo.y)/65535.0;vec4 f=field(int(pid)+1,t);vec3 ray=p-aPartRoot;float L=length(ray);vec3 T=ray/max(L,1e-9),U=normalize(uPartBend[int(pid)-1]);float w=partWeight(pid);vec3 pd=aPartRoot+ray*f.x+U*L*f.y;p=mix(p,pd,w);vec3 rawAxis=cross(T,U);float axisLength=length(rawAxis);if(w>0.0&&abs(f.z)>1e-8&&axisLength>1e-8)n=rotateAxis(n,rawAxis/axisLength,f.z*w);}
  float anchorX=clamp(aPosition.x,uBodyRange.x,uBodyRange.y);float s=(anchorX-uBodyRange.x)/(uBodyRange.y-uBodyRange.x);vec4 f=field(0,s),g=field(1,s);float ca=spineCos(f.w),sa=spineSin(f.w),cb=spineCos(g.x),sb=spineSin(g.x);vec3 T=vec3(ca*cb,sb,sa*cb),U=vec3(-ca*sb,cb,-sa*sb),N=vec3(-sa,0,ca);mat3 frame=mat3(T,U,N);p=vec3(anchorX+f.x,g.y+f.y,g.z+f.z)+frame*(p-vec3(anchorX,g.y,g.z));n=normalize(frame*n);
 }
 p.y-=.14;p*=shape.xyz;n=normalize(n/shape.xyz);float c=cos(root.w),ss=sin(root.w),cp=cos(local.z),sp=sin(local.z),cr=cos(local.w),sr=sin(local.w);mat3 rot=mat3(vec3(c*cp,-sp,-ss*cp),vec3(c*sp*cr+ss*sr,cp*cr,-ss*sp*cr+c*sr),vec3(-c*sp*sr+ss*cr,-cp*sr,ss*sp*sr+c*cr));p=rot*p+root.xyz;n=normalize(rot*n);
 vNormal=normalize(mat3(uView)*n);vViewPos=(uView*vec4(p,1)).xyz;vWorldPos=p;vUv=aUv;vW0=aW0;vW1=aW1;vW2=aW2;vPartId=aPartInfo.x;gl_Position=uMvp*vec4(p,1);
}`;
const MESH_FRAGMENT=`#version 300 es
precision highp float;precision highp int;
in vec3 vNormal,vViewPos,vWorldPos;
in vec4 vW0,vW1,vW2;
in vec2 vUv;flat in uint vPartId;flat in vec4 vTint;
uniform sampler2D uBase,uNormal,uRm;
uniform vec4 uResponse0,uResponse1,uResponse2;
uniform bool uNormalMap;
