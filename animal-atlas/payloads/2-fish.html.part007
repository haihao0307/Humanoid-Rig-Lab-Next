void main(){
 int fish=uSchool?gl_InstanceID:uPoseIndex;vec4 root=texelFetch(uInstances,ivec2(0,fish),0),shape=texelFetch(uInstances,ivec2(1,fish),0),color=texelFetch(uInstances,ivec2(2,fish),0),local=texelFetch(uInstances,ivec2(3,fish),0);vTint=vec4(color.rgb*shape.w,color.w);
 vec3 p=aPosition,n=octNormal(aNormalOct);
