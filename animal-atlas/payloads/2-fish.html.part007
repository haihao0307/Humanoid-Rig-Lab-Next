 drawPaths(m){m={...m,mvp:mat4Multiply(m.mvp,School.model(this.school.fish[this.state.selected],false))};const gl=this.gl;gl.disable(gl.DEPTH_TEST);this.path(m,this.h.state.worldCenters,[1,.68,.15,1]);const colors=[[.1,.9,1,1],[.75,.35,1,1],[1,.25,.5,1],[1,.55,.1,1],[.2,.9,.2,1],[.1,.55,1,1],[1,.9,.1,1]];for(const part of this.h.metadata.continuum.parts){const tip=this.partTips[part.id]?.i;if(tip==null)continue;const o=tip*3,root=this.h.partRoot.subarray(o,o+3),rest=this.h.positions.subarray(o,o+3),pts=[];for(let j=0;j<=36;j++){const q=j/36,p=[root[0]+q*(rest[0]-root[0]),root[1]+q*(rest[1]-root[1]),root[2]+q*(rest[2]-root[2])],w=new Uint8Array(12);w[part.id===1?5:part.id===2?6:part.id===3?7:part.id===4?8:part.id===5?9:part.id===6?10:11]=255;const bodyT=clamp((p[0]+.38)/.24),s=bodyT*bodyT*(3-2*bodyT);w[0]=Math.round(s*255);w[1]=255-w[0];const pi=new Uint16Array([part.id,Math.round(q*65535)]),pd=A.deformMaterial(this.h,p,[0,0,1],null,w,pi,root,true).position;pts.push(...pd);}this.path(m,new Float32Array(pts),colors[part.id-1]);}for(const side of [1,-1]){const f=A.eyeFrame(this.h,side,true),d=[Math.sin(f.gazeYaw),Math.sin(f.gazePitch),Math.cos(f.gazeYaw)*Math.cos(f.gazePitch)],world=[f.tangent[0]*d[0]+f.up[0]*d[1]+f.outward[0]*d[2],f.tangent[1]*d[0]+f.up[1]*d[1]+f.outward[1]*d[2],f.tangent[2]*d[0]+f.up[2]*d[1]+f.outward[2]*d[2]];this.path(m,new Float32Array([...f.center,f.center[0]+world[0]*.055,f.center[1]+world[1]*.055,f.center[2]+world[2]*.055]),[1,.75,.15,1]);}gl.enable(gl.DEPTH_TEST);}
 draw(x,y,w,h,animated){const gl=this.gl;gl.viewport(x,y,w,h);gl.scissor(x,y,w,h);gl.clearColor(.035,.055,.072,1);gl.clear(gl.COLOR_BUFFER_BIT|gl.DEPTH_BUFFER_BIT);const m=this.camera.mvp(w/h);this.applyMesh(this.program,m,animated);gl.bindVertexArray(this.vao);if(this.state.school)gl.drawElementsInstanced(gl.TRIANGLES,this.indexCount,gl.UNSIGNED_INT,0,FISH_COUNT);else gl.drawElements(gl.TRIANGLES,this.indexCount,gl.UNSIGNED_INT,0);this.drawEyes(m,animated);if(this.state.wire&&!this.state.school){gl.enable(gl.BLEND);gl.blendFunc(gl.SRC_ALPHA,gl.ONE_MINUS_SRC_ALPHA);this.applyMesh(this.wireProgram,m,animated);gl.bindVertexArray(this.wireVao);gl.drawElements(gl.LINES,this.edgeCount,gl.UNSIGNED_INT,0);gl.disable(gl.BLEND);}if(this.state.paths&&animated&&!this.state.school)this.drawPaths(m);gl.bindVertexArray(null);}
 frame(now){const elapsed=this.last?(now-this.last)/1000:0,dt=Math.min(.08,elapsed);this.last=now;this.refreshPointer();if(this.state.playing)this.advance(dt);this.uploadPoses();if(this.state.school){const center=this.school.fish.reduce((v,f)=>v.map((x,k)=>x+f.p[k]/FISH_COUNT),[0,0,0]);if(this.lastCenter)for(let k=0;k<3;k++)this.camera.target[k]+=center[k]-this.lastCenter[k];else this.camera.target=center;this.lastCenter=center;}const gl=this.gl;gl.activeTexture(gl.TEXTURE3);gl.bindTexture(gl.TEXTURE_2D,this.fieldTexture);const w=this.canvas.width,h=this.canvas.height,compare=!this.state.school&&this.state.compare&&w/this.dpr>780;gl.enable(gl.SCISSOR_TEST);if(compare){const half=w>>1;this.draw(0,0,half,h,false);this.draw(half,0,w-half,h,true);}else this.draw(0,0,w,h,true);gl.disable(gl.SCISSOR_TEST);if(++this.frames%10===0){document.getElementById('fps').textContent=(elapsed?Math.round(1/elapsed):0)+' FPS';document.getElementById('clock').textContent=this.h.state.time.toFixed(2)+' s';document.getElementById('drive').textContent=this.h.state.drive.toFixed(3);updateResponseUI(this);}document.getElementById('teacherLabel').style.display=compare?'block':'none';document.getElementById('activeLabel').style.left=compare?'calc(50% + 14px)':'14px';this.raf=requestAnimationFrame(t=>this.frame(t));}
 dispose(){cancelAnimationFrame(this.raf);this.observer.disconnect();const gl=this.gl;for(const b of [...this.buffers,...this.eyeBuffers,this.index,this.edge,this.eyeIndex,this.lineBuffer])gl.deleteBuffer(b);for(const v of [this.vao,this.wireVao,this.eyeVao,this.lineVao])gl.deleteVertexArray(v);for(const p of [this.program,this.wireProgram,this.eyeProgram,this.lineProgram])gl.deleteProgram(p);for(const t of [...Object.values(this.textures),this.fieldTexture,this.instanceTexture])gl.deleteTexture(t);for(const h of this.actors)A.dispose(h);}
}
function buildWeightUI(renderer){const host=document.getElementById('weightSliders');CHANNEL_LABELS.forEach((label,i)=>{if(i<5)return;const row=document.createElement('div');row.className='weight-row';row.innerHTML=`<label><span>${String(i+1).padStart(2,'0')} · ${label}</span><b id="wgVal${i}">1.00×</b></label><input id="wg${i}" type="range" min="0" max="1.8" step=".05" value="1"><div class="bar"><i id="resp${i}"></i></div>`;host.appendChild(row);row.querySelector('input').oninput=e=>{renderer.state.finGains[i-5]=+e.target.value;document.getElementById('wgVal'+i).textContent=(+e.target.value).toFixed(2)+'×';};});const sel=document.getElementById('weightChannel');CHANNEL_LABELS.forEach((x,i)=>{if(i<5)return;const o=document.createElement('option');o.value=i;o.textContent=String(i+1).padStart(2,'0')+' · '+x;sel.appendChild(o);});sel.value=5;sel.onchange=e=>renderer.state.weightChannel=+e.target.value;}
function updateResponseUI(renderer){const state=renderer.h.state,L=renderer.h.metadata.continuum.body.endXM-renderer.h.metadata.continuum.body.sourceXM;document.getElementById("gaitNow").textContent=`尾摆 ${state.beatFrequencyHz.toFixed(2)} Hz · 推进估计 ${(state.swimSpeedMps/L).toFixed(2)} 体长／秒`;const s=state.response;for(let i=0;i<12;i++){const bar=document.getElementById('resp'+i);if(bar){const v=clamp(s[i]/1.6);bar.style.width=(v*100)+'%';bar.title='当前动作响应 '+s[i].toFixed(3);}}document.getElementById('eyeNow').textContent=`眼球 yaw ${renderer.h.state.eyeYaw.toFixed(3)} · pitch ${renderer.h.state.eyePitch.toFixed(3)} · pupil ${renderer.h.state.pupil.toFixed(3)}`;}
async function bindUi(renderer){
 const by=id=>document.getElementById(id),h=renderer.h;buildWeightUI(renderer);const select=by('fishSelect');for(let i=0;i<FISH_COUNT;i++){const o=document.createElement('option');o.value=i;o.textContent=i===0?'01 · 源采样基准':String(i+1).padStart(2,'0')+' · 个体变体';select.appendChild(o);}select.onchange=e=>{renderer.state.selected=+e.target.value;renderer.h=renderer.actors[renderer.state.selected];updateVariantUI(renderer);};by('schoolToggle').onchange=e=>renderer.setSchool(e.target.checked);by('singleFish').onclick=()=>renderer.setSchool(false);by('wholeSchool').onclick=()=>renderer.setSchool(true);by('swing').oninput=e=>{renderer.state.swing=+e.target.value;by('swingValue').textContent=renderer.state.swing.toFixed(2)+'×';};by('pointerToggle').onchange=e=>{renderer.state.pointer=e.target.checked;renderer.pointer=null;School.clearInteraction(renderer.school);};by('disturb').onclick=()=>renderer.clickDisturbance(renderer.pointerRay(renderer.canvas.getBoundingClientRect().left+renderer.canvas.clientWidth/2,renderer.canvas.getBoundingClientRect().top+renderer.canvas.clientHeight/2));renderer.setSchool(true);updateVariantUI(renderer);const modeHost=by('motions');for(const [id,p] of Object.entries(h.metadata.motion.modes)){const b=document.createElement('button');b.textContent=p.label;b.dataset.motion=id;b.classList.toggle('active',id===renderer.state.mode);modeHost.appendChild(b);b.onclick=()=>{renderer.state.mode=id;renderer.setMode(id);modeHost.querySelectorAll('button').forEach(x=>x.classList.toggle('active',x===b));by('modeNow').textContent=p.label;updateResponseUI(renderer);};}by('play').onclick=()=>{renderer.state.playing=!renderer.state.playing;by('play').textContent=renderer.state.playing?'暂停':'播放';};by('step').onclick=()=>{renderer.state.playing=false;by('play').textContent='播放';renderer.advance(1/30);};by('resetTime').onclick=()=>renderer.resetAll();
 for(const [id,key,out] of [['speed','speed','speedValue'],['amplitude','amplitude','amplitudeValue'],['eyeYaw','eyeYawOffset','eyeYawValue'],['eyePitch','eyePitchOffset','eyePitchValue'],['pupil','pupilBias','pupilValue']])by(id).oninput=e=>{renderer.state[key]=+e.target.value;by(out).textContent=(+e.target.value).toFixed(2);};for(const [id,key]of[['wire','wire'],['normalMap','normalMap'],['compare','compare'],['eyes','eyes']])by(id).onchange=e=>renderer.state[key]=e.target.checked;by('renderMode').onchange=e=>renderer.state.renderMode=+e.target.value;
 document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>{renderer.camera.target=[0,.14,0];renderer.camera.zoom=1;renderer.setSchool(false);const v=b.dataset.view;if(v==='eyePos'){renderer.camera.setView('left');renderer.camera.target=[-.343,.159,.061];renderer.camera.zoom=11.5;}else if(v==='eyeNeg'){renderer.camera.setView('right');renderer.camera.target=[-.344,.159,-.059];renderer.camera.zoom=11.5;}else if(v==='eyes'){renderer.camera.setView('head');renderer.camera.target=[-.344,.159,0];renderer.camera.zoom=5.8;}else if(v==='jaw'){renderer.camera.setView('left');renderer.camera.target=[-.41,.124,0];renderer.camera.zoom=4.8;}else if(v==='finPos'){renderer.camera.setView('left');renderer.camera.target=[-.155,.124,.08];renderer.camera.zoom=5.5;renderer.camera.pitch=.35;}else if(v==='finNeg'){renderer.camera.setView('right');renderer.camera.target=[-.155,.124,-.08];renderer.camera.zoom=5.5;renderer.camera.pitch=.35;}else renderer.camera.setView(v);transformVariantView(renderer);});
 by('eyeIsolate').onclick=()=>{renderer.setSchool(false);renderer.state.renderMode=7;by('renderMode').value='7';renderer.camera.setView('left');renderer.camera.target=[-.343,.159,.061];renderer.camera.zoom=11.5;transformVariantView(renderer);};by('eyeTrack').onclick=()=>{renderer.setSchool(false);[...modeHost.children].find(x=>x.dataset.motion==='EYE_TRACK')?.click();renderer.camera.setView('left');renderer.camera.target=[-.343,.159,.061];renderer.camera.zoom=11.5;transformVariantView(renderer);};by('resetWeights').onclick=()=>{renderer.state.finGains.fill(1);for(let i=5;i<12;i++){by('wg'+i).value='1';by('wgVal'+i).textContent='1.00×';}};
 by('export').onclick=()=>{const state={version:'R13',mode:renderer.state.mode,time:h.state.time,finGains:renderer.state.finGains,eye:{yawOffset:renderer.state.eyeYawOffset,pitchOffset:renderer.state.eyePitchOffset,pupilBias:renderer.state.pupilBias},note:'Central spine full-section transport; only seven fin response gains; separate measured-position eyes; visual approval remains false.'},url=URL.createObjectURL(new Blob([JSON.stringify(state,null,2)],{type:'application/json'})),a=document.createElement('a');a.href=url;a.download='R13-weight-eye-test-settings.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};window.addEventListener('keydown',e=>{if(e.code==='Space'&&!/INPUT|SELECT/.test(e.target.tagName)){e.preventDefault();by('play').click();}});window.addEventListener('pagehide',()=>renderer.dispose(),{once:true});}
async function boot(){try{setLoad('读取 KFC13 中心脊椎与 7 组鱼鳍',.03);const h=await A.build(readScore(),p=>setLoad('重演完整表面 '+Math.round(p*100)+'%',.08+.56*p));setLoad('解码原始 4K 表面图与独立眼球',.7);const canvas=document.getElementById('gl'),gl=canvas.getContext('webgl2',{antialias:true,alpha:false,powerPreference:'high-performance',preserveDrawingBuffer:false});if(!gl)throw Error('此浏览器未提供 WebGL2。请开启图形加速。');const textures={base:await texture(gl,h.textures.base,'image/jpeg'),normal:await texture(gl,h.textures.normal,h.metadata.package.normalMime),rm:await texture(gl,h.textures.rm,'image/jpeg')};const renderer=new Renderer(canvas,h,gl,textures);await bindUi(renderer);document.body.classList.toggle('player',!WORKBENCH_MODE);byReady(h);window.__KAOPU_R13__={ready:true,renderer,get handle(){return renderer.h},instrument:A,school:School,shaders:{meshVertex:MESH_VERTEX,meshFragment:MESH_FRAGMENT,eyeVertex:EYE_VERTEX,eyeFragment:EYE_FRAGMENT}};document.getElementById('loader').classList.add('done');requestAnimationFrame(t=>renderer.frame(t));}catch(e){console.error(e);setLoad('启动失败：'+e.message,1);document.getElementById('loader').classList.add('failed');window.__KAOPU_R13__={ready:false,error:String(e.stack||e)};}}
function transformVariantView(r){const m=School.model(r.school.fish[r.state.selected],false),p=r.camera.target;r.camera.target=[m[0]*p[0]+m[4]*p[1]+m[8]*p[2]+m[12],m[1]*p[0]+m[5]*p[1]+m[9]*p[2]+m[13],m[2]*p[0]+m[6]*p[1]+m[10]*p[2]+m[14]];r.camera.zoom/=r.school.fish[r.state.selected].variant.size;}
function updateVariantUI(r){const v=r.school.fish[r.state.selected].variant;document.getElementById('variantNow').textContent='尺寸 '+v.size.toFixed(2)+'× · 体长 '+v.length.toFixed(2)+'× · 体高 '+v.depth.toFixed(2)+'× · 体宽 '+v.width.toFixed(2)+'×';}
function byReady(h){document.getElementById('stats').textContent=h.metadata.counts.vertices.toLocaleString()+' 点 · '+h.metadata.counts.triangles.toLocaleString()+' 三角 · 7 组鱼鳍权重';document.getElementById('version').textContent='R13 · KFC13 · posterior wave + coupled tail + KFE1 eye';document.getElementById('eyeEvidence').textContent=`+Z 眼 ${h.metadata.continuum.eyes.eyes[0].sourceEyeSamples.toLocaleString()} 源样本 · −Z 眼 ${h.metadata.continuum.eyes.eyes[1].sourceEyeSamples.toLocaleString()} 源样本`;}
boot();
</script></body></html>
