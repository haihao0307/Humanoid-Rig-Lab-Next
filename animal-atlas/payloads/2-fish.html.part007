 for(let i=0;i<7;i++){const gain=options.finGains?.[i]??1;r[i+5]=ratios[i+5]*clamp(Number.isFinite(gain)?gain:1,0,1.8);}
 return r;
}

// User-authorized animation envelope, not species physiological calibration.
function gazeNoise(seed,cycle,salt){let x=(seed+Math.imul(cycle+1,0x9e3779b9)+Math.imul(salt,0x85ebca6b))|0;x=Math.imul(x^(x>>>16),0x7feb352d);x=Math.imul(x^(x>>>15),0x846ca68b);return((x^(x>>>16))>>>0)/4294967296;}
function newGaze(seed=90401){return [0,1].map(side=>{const id=(seed+side*13007)|0;return {seed:id,cycle:-1,nextAt:.45+1.7*gazeNoise(id,0,1),started:0,travel:.14,fromYaw:0,fromPitch:0,targetYaw:0,targetPitch:0,yaw:0,yawV:0,pitch:0,pitchV:0};});}
function gazeTarget(g,time,wide){if(time>=g.nextAt){g.cycle++;g.fromYaw=g.targetYaw;g.fromPitch=g.targetPitch;const home=gazeNoise(g.seed,g.cycle,2)<.28;g.targetYaw=home?0:(gazeNoise(g.seed,g.cycle,3)*2-1)*(wide?.125:.047);g.targetPitch=home?0:(gazeNoise(g.seed,g.cycle,4)*2-1)*(wide?.055:.023);g.started=time;g.travel=.12+.10*gazeNoise(g.seed,g.cycle,5);g.nextAt=time+g.travel+1.9+2.5*gazeNoise(g.seed,g.cycle,6);}const u=clamp((time-g.started)/g.travel),ease=u*u*u*(u*(u*6-15)+10);return [lerp(g.fromYaw,g.targetYaw,ease),lerp(g.fromPitch,g.targetPitch,ease)];}
