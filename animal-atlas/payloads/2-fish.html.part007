  s.accumulator-=dt;s.time+=dt;s.modeTime+=dt;springStep(s,'driveStrength',amp,20,9,dt);const drive=clamp(s.driveStrength,0,1.6),frequency=(p.frequency||0)*(.65+.35*drive)*clamp(options.gaitFrequencyScale??1,.7,1.35);s.beatFrequencyHz+=Math.min(1,dt*4)*(frequency-s.beatFrequencyHz);s.beatPhase=(s.beatPhase+TAU*s.beatFrequencyHz*dt)%TAU;const f=forcing(mode,p,s.modeTime,s.beatPhase);s.drive=f.body*drive;
