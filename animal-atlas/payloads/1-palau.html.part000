wing')).normalize();\n const y=worldPosition('tail').sub(worldPosition('head')).normalize();y.addScaledVector(x,-y.dot(x)).normalize();const z=x.clone().cross(y).normalize();\n const frame=quat().setFromRotationMatrix(new T.Matrix4().makeBasis(x,y,z));\n const toCanonical=frame.clone().invert();\n let calibrationTime=0,best=-Infinity;\n // Choose an actual upper-stroke frame to align with the supplied raised-wing reference poses.\n for(let i=0;i\u003c=180;i++){const t=clip.duration*i/180;evaluate(t);const p=worldPosition('Ltip').add(worldPosition('Rtip')).multiplyScalar(.5).sub(worldPosition('body')).applyQuaternion(toCanonical);if(p.z>best){best=p.z;calibrationTime=t}}\n evaluate(calibrationTime);const reference={};for(const [name,id] of Object.entries(map))reference[name]=nodes[id].getWorldQuaternion(quat());\n const outgoing={},referenceNormals={};\n for(const [name,id] of Object.entries(map)){\n  const prefix=name[0],part=name.slice(1),next=part==='wing'?'elbow':part==='elbow'?'wrist':part==='wrist'?'tip':part==='tip'?'feathers':part==='hip'?'knee':part==='knee'?'foot':part==='foot'?'toe0':null;\n  const child=next?map[prefix+next]:(source.nodes[id].children||[]).find(c=>nodes[c].position.length()>.00001);\n  if(child===undefined)continue;\n  outgoing[name]=child;\n  const direction=nodes[child].getWorldPosition(vec()).sub(nodes[id].getWorldPosition(vec())).applyQuaternion(toCanonical).normalize();\n  let normal;\n  if(/(wing|elbow|wrist|tip|feathers)$/.test(name))normal=direction.clone().cross(new T.Vector3(0,1,0)).multiplyScalar(prefix==='L'?1:-1);\n  else normal=new T.Vector3(1,0,0).addScaledVector(direction,-direction.x);\n  if(normal.lengthSq()\u003c1e-8)normal=new T.Vector3(0,0,1).addScaledVector(direction,-direction.z);\n  referenceNormals[name]=normal.normalize();\n }\n const baseRoot=worldPosition('body');const span=worldPosition('Ltip').distanceTo(worldPosition('Rtip'));\n let wingNeutralTime=0,neutralScore=-Infinity;\n for(let i=0;i\u003c=180;i++){const t=clip.duration*i/180;evaluate(t);const l=worldPosition('Ltip').sub(worldPosition('Lwing')).applyQuaternion(toCanonical),r=worldPosition('Rtip').sub(worldPosition('Rwing')).applyQuaternion(toCanonical);const score=Math.abs(l.x-r.x)-2*(Math.abs(l.z)+Math.abs(r.z));if(score>neutralScore){neutralScore=score;wingNeutralTime=t}}\n evaluate(wingNeutralTime);const wingReference={};for(const [name,id] of Object.entries(map))if(/(wing|elbow|wrist|tip|feathers)$/.test(name))wingReference[name]=nodes[id].getWorldQuaternion(quat());\n function pose(time){evaluate(time);const rotations={},flightRotations={},frames={},directions={};for(const [name,id] of Object.entries(map)){const delta=nodes[id].getWorldQuaternion(quat()).multiply(reference[name].clone().invert());rotations[name]=toCanonical.clone().multiply(delta).multiply(frame).normalize();\n   if(wingReference[name])flightRotations[name]=toCanonical.clone().multiply(nodes[id].getWorldQuaternion(quat()).multiply(wingReference[name].clone().invert())).multiply(frame).normalize();\n   if(outgoing[name]!==undefined){\n    const direction=nodes[outgoing[name]].getWorldPosition(vec()).sub(nodes[id].getWorldPosition(vec())).applyQuaternion(toCanonical).normalize();\n    let normal=referenceNormals[name].clone().applyQuaternion(rotations[name]);normal.addScaledVector(direction,-normal.dot(direction));\n    if(normal.lengthSq()\u003c1e-8)normal=new T.Vector3(0,1,0).addScaledVector(direction,-direction.y);\n    normal.normalize();const tangent=normal.clone().cross(direction).normalize();normal=direction.clone().cross(tangent).normalize();\n    frames[name]=quat().setFromRotationMatrix(new T.Matrix4().makeBasis(direction,tangent,normal));directions[name]=direction;\n   }\n  }\n  // Eagle has left/right tail branches; neither alone is the target fan center.\n  const tailChildren=(source.nodes[map.tail].children||[]),tailEnd=tailChildren.reduce((p,id)=>p.add(nodes[id].getWorldPosition(vec())),vec()).multiplyScalar(1/tailChildren.length);\n  const tailDirection=tailEnd.sub(worldPosition('tail')).applyQuaternion(toCanonical).normalize();\n  const translation=worldPosition('body').sub(baseRoot).applyQuaternion(toCanonical).multiplyScalar(1/Math.max(1,span));return {rotations,flightRotations,frames,directions,tailDirection,translation};\n }\n return {source,root,nodes,map,clip,frame,calibrationTime,wingNeutralTime,span,evaluate,pose,worldPosition};\n}\n","rig":"import * as T from '../vendor/three.module.js';\nimport {unpack} from './full-surface.js';\nimport {createSourcePlayer} from './source-animation.js';\n\nconst Q=()=>new T.Quaternion(),V=a=>new T.Vector3(...a);\nconst dqGLSL=`\nvec4 dqMul(vec4 a,vec4 b){return vec4(a.w*b.xyz+b.w*a.xyz+cross(a.xyz,b.xyz),a.w*b.w-dot(a.xyz,b.xyz));}\nvec3 dqRotate(vec4 q,vec3 p){return p+2.0*cross(q.xyz,cross(q.xyz,p)+q.w*p);}\nvoid dqBlend(out vec4 r,out vec4 d){\n r=vec4(0.0);d=vec4(0.0);\n for(int k=0;k\u003c16;k++){int j=k%4;int id=int(k\u003c4?skinIndex[j]:k\u003c8?skinIndexB[j]:k\u003c12?skinIndexC[j]:skinIndexD[j]);float w=k\u003c4?skinWeight[j]:k\u003c8?skinWeightB[j]:k\u003c12?skinWeightC[j]:skinWeightD[j];r+=dqReal[id]*w;d+=dqDual[id]*w;}\n float len=max(length(r),0.0000001);r/=len;d/=len;d-=r*dot(r,d);\n}\nvec3 dqPoint(vec4 r,vec4 d,vec3 p){return dqRotate(r,p)+2.0*dqMul(d,vec4(-r.xyz,r.w)).xyz;}\n`;\nfunction frame(direction){const x=direction.clone().normalize(),z=new T.Vector3(1,0,0).addScaledVector(x,-x.x).normalize();if(z.lengthSq()\u003c1e-8)z.set(0,0,1).addScaledVector(x,-x.z).normalize();const y=z.clone().cross(x).normalize();return Q().setFromRotationMatrix(new T.Matrix4().makeBasis(x,y,x.clone().cross(y).normalize()))}\nexport function createAnatomicalRig(surface,score,motions){\n const group=new T.Group(),center=V(score.referenceBodyCenter);group.position.set(0,-center.y,.49-center.z);\n const bones=score.bones.map(b=>{const o=new T.Bone();o.name=b.name;o.position.fromArray(b.position);if(b.parent>=0)o.position.sub(V(score.bones[b.parent].position));return o}),byName=Object.fromEntries(bones.map(b=>[b.name,b]));score.bones.forEach((b,i)=>(b.parent>=0?bones[b.parent]:group).add(bones[i]));\n const geometry=surface.geometry.clone(),indices=unpack(score.skinIndex),weights=unpack(score.skinWeight),count=geometry.attributes.position.count;\n for(let half=0;half\u003c4;half++){const ids=new Uint16Array(count*4),ws=new Float32Array(count*4),suffix=['','B','C','D'][half];for(let i=0;i\u003ccount;i++)for(let k=0;k\u003c4;k++){ids[i*4+k]=indices[i*16+half*4+k];ws[i*4+k]=weights[i*16+half*4+k]}geometry.setAttribute('skinIndex'+suffix,new T.Uint16BufferAttribute(ids,4));geometry.setAttribute('skinWeight'+suffix,new T.Float32BufferAttribute(ws,4))}\n geometry.setAttribute('anatomicalOwner',new T.Uint16BufferAttribute(unpack(score.owners),1));geometry.setAttribute('jointZone',new T.Uint8BufferAttribute(unpack(score.jointZones),1));\n const material=surface.material.clone(),mesh=new T.SkinnedMesh(geometry,material);mesh.frustumCulled=false;group.add(mesh);group.updateMatrixWorld(true);const skeleton=new T.Skeleton(bones);skeleton.calculateInverses();mesh.bind(skeleton,mesh.matrixWorld);const real=bones.map(()=>new T.Vector4(0,0,0,1)),dual=bones.map(()=>new T.Vector4()),world=bones.map(Q),matrix=new T.Matrix4(),q=Q(),translation=new T.Vector3(),d=Q();\n material.onBeforeCompile=shader=>{shader.uniforms.dqReal={value:real};shader.uniforms.dqDual={value:dual};shader.vertexShader=shader.vertexShader.replace('#include \u003ccommon>','#include \u003ccommon>\\nattribute vec4 skinIndexB;\\nattribute vec4 skinWeightB;\\nattribute vec4 skinIndexC;\\nattribute vec4 skinWeightC;\\nattribute vec4 skinIndexD;\\nattribute vec4 skinWeightD;\\nuniform vec4 dqReal['+bones.length+'];\\nuniform vec4 dqDual['+bones.length+'];\\n'+dqGLSL).replace('#include \u003cskinning_vertex>','vec4 dr,dd;dqBlend(dr,dd);transformed=dqPoint(dr,dd,transformed);').replace('#include \u003cskinnormal_vertex>','vec4 nr,nd;dqBlend(nr,nd);objectNormal=dqRotate(nr,objectNormal);\\n#ifdef USE_TANGENT\\nobjectTangent=dqRotate(nr,objectTangent);\\n#endif')};material.customProgramCacheKey=()=>score.id+'-dual-quaternion-v4-sixteen';\n function updateDual(){group.updateMatrixWorld(true);skeleton.update();for(let i=0;i\u003cbones.length;i++){matrix.copy(mesh.bindMatrixInverse).multiply(bones[i].matrixWorld).multiply(skeleton.boneInverses[i]).multiply(mesh.bindMatrix);q.setFromRotationMatrix(matrix).normalize();const parent=score.bones[i].parent,anchor=parent>=0?real[parent]:new T.Vector4(0,0,0,1);if(q.x*anchor.x+q.y*anchor.y+q.z*anchor.z+q.w*anchor.w\u003c0)q.set(-q.x,-q.y,-q.z,-q.w);translation.setFromMatrixPosition(matrix);d.set(translation.x,translation.y,translation.z,0).multiply(q);real[i].set(q.x,q.y,q.z,q.w);dual[i].set(d.x*.5,d.y*.5,d.z*.5,d.w*.5)}}\n mesh.getVertexPosition=function(i,out){out.fromBufferAttribute(geometry.attributes.position,i);const r=new T.Vector4(0,0,0,0),du=new T.Vector4(0,0,0,0);for(let k=0;k\u003c16;k++){const id=indices[i*16+k],w=weights[i*16+k];r.addScaledVector(real[id],w);du.addScaledVector(dual[id],w)}const len=r.length()||1;r.multiplyScalar(1/len);du.multiplyScalar(1/len).addScaledVector(r,-r.dot(du));const qr=new T.Quaternion(r.x,r.y,r.z,r.w),qd=new T.Quaternion(du.x,du.y,du.z,du.w).multiply(qr.clone().conjugate());return out.applyQuaternion(qr).add(new T.Vector3(qd.x,qd.y,qd.z).multiplyScalar(2))};\n // Allocation-free mirror of the shader for exhaustive offline shape checks.\n mesh.getDeformedPositions=function(out=new Float64Array(count*3)){\n  const p=geometry.attributes.position.array;\n  for(let i=0;i\u003ccount;i++){\n   let x=0,y=0,z=0,w=0,dx=0,dy=0,dz=0,dw=0;\n   for(let k=0;k\u003c16;k++){const wt=weights[i*16+k];if(!wt)continue;const bi=indices[i*16+k],r=real[bi],d=dual[bi];x+=wt*r.x;y+=wt*r.y;z+=wt*r.z;w+=wt*r.w;dx+=wt*d.x;dy+=wt*d.y;dz+=wt*d.z;dw+=wt*d.w}\n   const inv=1/(Math.hypot(x,y,z,w)||1);x*=inv;y*=inv;z*=inv;w*=inv;dx*=inv;dy*=inv;dz*=inv;dw*=inv;const dot=x*dx+y*dy+z*dz+w*dw;dx-=x*dot;dy-=y*dot;dz-=z*dot;dw-=w*dot;\n   const px=p[i*3],py=p[i*3+1],pz=p[i*3+2],tx=2*(y*pz-z*py),ty=2*(z*px-x*pz),tz=2*(x*py-y*px);\n   out[i*3]=px+w*tx+y*tz-z*ty+2*(w*dx-dw*x-dy*z+dz*y);\n   out[i*3+1]=py+w*ty+z*tx-x*tz+2*(w*dy-dw*y-dz*x+dx*z);\n   out[i*3+2]=pz+w*tz+x*ty-y*tx+2*(w*dz-dw*z-dx*y+dy*x);\n  }return out;\n };\n const players=Object.fromEntries(Object.entries(motions).map(([id,s])=>[id,createSourcePlayer(s,{extraMap:{Lsecondary:id==='pigeon'?47:22,Rsecondary:id==='pigeon'?55:28}})])),restFrames={};\n for(const prefix of ['L','R'])for(const part of ['hip','knee','foot','toe0','toe1','toe2']){const name=prefix+part,b=score.bones.find(b=>b.name===name),next=part==='hip'?prefix+'knee':part==='knee'?prefix+'foot':part==='foot'?prefix+'toe0':null;let direction=next?V(score.bones.find(b=>b.name===next).position).sub(V(b.position)):new T.Vector3(0,-1,-.25);if(direction.lengthSq()\u003c1e-8)direction.set(0,-1,0);restFrames[name]=frame(direction)}\n const neutralHead=Q().setFromAxisAngle(new T.Vector3(0,0,1),-score.landmarks.gazeYaw),bodyPitch=Q().setFromAxisAngle(new T.Vector3(1,0,0),score.flightPitch);\n const idealWorld=bones.map(Q);\n let source='pigeon',time=0,inspection=null;const helper=new T.SkeletonHelper(group);helper.visible=false;helper.material.depthTest=false;helper.renderOrder=20;\n function reset(){bones.forEach((b,i)=>{b.position.fromArray(score.bones[i].position);if(score.bones[i].parent>=0)b.position.sub(V(score.bones[score.bones[i].parent].position));b.quaternion.identity()})}\n function poseAt(source,t){const player=players[source],duration=player.clip.duration,local=((t%duration)+duration)%duration,pose=player.pose(local),seam=Math.min(.06,duration*.08);if(local>duration-seam){const start=player.pose(0),x=(local-duration+seam)/seam,u=x*x*(3-2*x);for(const key of Object.keys(pose.rotations)){pose.rotations[key].slerp(start.rotations[key],u);if(pose.frames[key])pose.frames[key].slerp(start.frames[key],u)}pose.tailDirection.lerp(start.tailDirection,u).normalize();pose.translation.lerp(start.translation,u)}return pose}\n function setTime(t,{source:next=source}={}){\n  source=next;time=t;reset();if(inspection){const bi=bones.findIndex(b=>b.name===inspection.name);if(bi>=0&&score.bones[bi].role!=='RIGID_THORAX')bones[bi].quaternion.setFromAxisAngle(new T.Vector3(...inspection.axis),inspection.angle);updateDual();return snapshot()}\n  if(source==='static'){updateDual();return snapshot()}\n  const player=players[source],pose=poseAt(source,t);\n  for(let i=0;i\u003cbones.length;i++){\n   const spec=score.bones[i],name=spec.name,parent=spec.parent;let desired=Q();\n   if(name==='body')desired.copy(pose.rotations.body).multiply(bodyPitch);\n   else if(name==='neck0'||name==='neck1'){const amount=name==='neck0'?.60:.20;desired.copy(pose.rotations.body).multiply(Q().slerp(pose.rotations.body.clone().invert().multiply(pose.rotations.neck),.75)).multiply(Q().setFromAxisAngle(new T.Vector3(1,0,0),amount*score.flightPitch)).multiply(Q().setFromAxisAngle(new T.Vector3(0,0,1),-score.landmarks.gazeYaw*(1-amount)))}\n   else if(name==='head')desired.copy(pose.rotations.body).multiply(Q().slerp(pose.rotations.body.clone().invert().multiply(pose.rotations.head),.75)).multiply(neutralHead);\n   else if(name==='tail')desired.setFromUnitVectors(V(score.landmarks.tailDirection||[0,.25,-.97]),pose.tailDirection);\n   else if(name.endsWith('secondary'))desired.copy(pose.rotations[name]);\n   else if(name.endsWith('hip'))desired.copy(world[parent]);\n   else if(/(toe[012]|hind)$/.test(name))desired.copy(world[parent]);\n   else if(/(knee|foot)$/.test(name))desired.copy(world[0]).multiply(Q().slerp(pose.rotations[name]||Q(),.35));\n   else desired.copy(pose.rotations[spec.sourceMap]||Q());\n   idealWorld[i].copy(desired);\n   const wingChild=/(elbow|wrist|primary|secondary)$/.test(name);\n   // Calibrate the donor LOCAL hinge delta before reducing its parent's\n   // amplitude. Otherwise a reduced shoulder is falsely added to the elbow\n   // and wrist as extra bending, making a stiff wing kink around the body.\n   bones[i].quaternion.copy(parent>=0?(wingChild?idealWorld[parent]:world[parent]):Q()).invert().multiply(desired).normalize();\n   if(name==='Lwing'||name==='Rwing')bones[i].quaternion.copy(Q().slerp(bones[i].quaternion,.45));\n   // These references have no authored joints. Preserve the donor shoulder\n   // stroke; scale subordinate flexion to the measured, straighter wing rest.\n   if(/(elbow|wrist|primary|secondary)$/.test(name)){const flex=name.endsWith('elbow')?.50:name.endsWith('wrist')?.40:.20;bones[i].quaternion.copy(Q().slerp(bones[i].quaternion,flex))}\n   world[i].copy(parent>=0?world[parent]:Q()).multiply(bones[i].quaternion);\n  }\n  byName.body.position.z+=pose.translation.z*.012;updateDual();return snapshot();\n }\n function snapshot(){return{source,time,duration:players[source]?.clip.duration||1,boneCount:bones.length,bones:Object.fromEntries(bones.map(b=>[b.name,{position:b.getWorldPosition(new T.Vector3()).toArray(),quaternion:b.getWorldQuaternion(Q()).toArray()}]))}}\n function inspect(name=null,angle=0,axis=[0,1,0]){inspection=name?{name,angle,axis}:null;setTime(time,{source})}\n setTime(0);return{group,mesh,meshes:[mesh],bones,skeleton,helper,score,players,setTime,snapshot,inspect,updateDual,bindingReport:{version:'R04-anatomical-ownership',boneCount:bones.length,regions:score.regions.length,triangles:geometry.index.count/3,geometryEdited:false,dualQuaternion:true,allowedInterfaces:score.interfaces.length}};\n}\n","app":"import * as T from '../vendor/three.module.js';\nimport {createFullSurface,unpack} from './full-surface.js';\nimport {createAnatomicalRig} from './anatomical-rig.js';\nwindow.ready=false;window.qa={version:'R04',errors:[],models:[]};\nconst $=id=>document.getElementById(id),params=new URLSearchParams(location.search),info=[['source_4','密克罗尼西亚椋鸟','Aplonis opaca'],['source_2','帕劳果鸠','Ptilinopus pelewensis'],['source_1','白燕鸥','Gygis candida']],stages=[];\nasync function compressed(path){const b=await(await fetch(path)).arrayBuffer();return JSON.parse(await new Response(new Blob([b]).stream().pipeThrough(new DecompressionStream('gzip'))).text())}\nconst motions=window.PALAU_MOTIONS||await(await fetch('motion/source-clips.json')).json();let source=params.get('motion')||'pigeon',time=Number(params.get('time')||0),speed=1,playing=!params.has('paused'),last=performance.now(),joint=null;\nconst previous=document.createElement('button'),next=document.createElement('button');previous.textContent='上一帧';next.textContent='下一帧';$('reset').after(previous,next);previous.onclick=()=>{playing=false;setTime(Math.max(0,time-1/60))};next.onclick=()=>{playing=false;setTime(time+1/60)};\nconst zoomLabel=document.createElement('label');zoomLabel.textContent='放大 ';const zoomSelect=document.createElement('select');zoomSelect.id='zoom';zoomSelect.innerHTML='\u003coption value=\"1\">1×\u003c/option>\u003coption value=\"1.3\">1.3×\u003c/option>\u003coption value=\"1.7\">1.7×\u003c/option>';zoomLabel.append(zoomSelect);$('view').parentElement.after(zoomLabel);zoomSelect.onchange=()=>draw();\n$('motion').value=source;$('view').value=params.get('view')||'threequarter';\nfunction cameraAt(stage){const view=$('view').value,camera=stage.camera,focus=new T.Vector3(0,0,.49),close=view.startsWith('head');if(close)focus.copy(stage.rig.bones.find(b=>b.name==='head').getWorldPosition(new T.Vector3()));camera.up.set(0,0,1);camera.zoom=(close?3.0:1)*Number(zoomSelect.value);if(view==='front'||view==='head-front')camera.position.set(focus.x,-3,focus.z);else if(view==='side'||view==='head-side')camera.position.set(3,focus.y,focus.z);else if(view==='left')camera.position.set(-3,focus.y,focus.z);else if(view==='back')camera.position.set(focus.x,3,focus.z);else if(view==='top'){camera.up.set(0,1,0);camera.position.set(0,0,3)}else if(view==='bottom'){camera.up.set(0,-1,0);camera.position.set(0,0,-3)}else camera.position.set(1.7,-2.5,1.05);camera.lookAt(focus);camera.updateProjectionMatrix()}\nfor(const [id,name,scientific]of info){\n const surface=window.PALAU_SURFACES?.[id]||await compressed('surface/'+id+'.json.gz'),binding=window.PALAU_BINDINGS?.[id]||await compressed('binding/'+id+'.json.gz'),start=performance.now(),reference=createFullSurface(surface),rig=createAnatomicalRig(reference,binding,motions);\n const article=document.createElement('article');article.innerHTML=`\u003ch2>${name}\u003c/h2>\u003cp>\u003ci>${scientific}\u003c/i>\u003c/p>`;$('cards').append(article);const renderer=new T.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});renderer.setSize(620,620);renderer.setPixelRatio(1);renderer.outputColorSpace=T.SRGBColorSpace;renderer.setClearColor(0xe2e7e5);article.append(renderer.domElement);article.insertAdjacentHTML('beforeend',`\u003cp class=\"caption\">完整参考曲面 · ${binding.regions.length} 身体分区 · ${binding.bones.length} 骨骼\u003c/p>`);\n const scene=new T.Scene(),camera=new T.OrthographicCamera(-.95,.95,.95,-.95,.01,20);scene.add(new T.HemisphereLight(0xffffff,0x8da59e,2.0));const light=new T.DirectionalLight(0xffffff,2.0);light.position.set(2,-3,4);scene.add(light,rig.group,rig.helper);\n const originalColors=rig.mesh.geometry.attributes.color,owners=unpack(binding.owners),zones=unpack(binding.jointZones),regionColors=new Float32Array(owners.length*3),sleeveColors=new Float32Array(owners.length*3);for(let i=0;i\u003cowners.length;i++){const c=new T.Color().setHSL((owners[i]*.618)%1,.67,.48).convertSRGBToLinear();c.toArray(regionColors,i*3);new T.Color(zones[i]?0xef922e:0xd9dedb).convertSRGBToLinear().toArray(sleeveColors,i*3)}\n stages.push({id,renderer,scene,camera,rig,reference,originalColors,regionColors:new T.BufferAttribute(regionColors,3),sleeveColors:new T.BufferAttribute(sleeveColors,3)});window.qa.models.push({id,generationMs:performance.now()-start,...rig.bindingReport});\n}\nfunction duration(){return motions[source]?.clips[0].duration||1}\nfunction draw(){for(const s of stages){s.rig.setTime(time,{source});s.rig.helper.visible=$('bones').checked;const g=s.rig.mesh.geometry,c=$('sleeves').checked?s.sleeveColors:$('regions').checked?s.regionColors:s.originalColors;if(g.attributes.color!==c){g.setAttribute('color',c);c.needsUpdate=true}s.rig.mesh.material.wireframe=$('wire').checked;cameraAt(s);s.renderer.render(s.scene,s.camera)}$('play').textContent=playing?'暂停':'播放';$('timeline').value=source==='static'?0:(time%duration())/duration();$('clock').textContent=joint?'单关节检查':source==='static'?'参考姿态':`${(time%duration()).toFixed(2)} / ${duration().toFixed(2)} 秒`}\nfunction setSource(v){joint=null;$(\"joint\").value=\"\";for(const s of stages)s.rig.inspect(null);source=v;time=0;$('motion').value=v;draw()}function setTime(v){time=Math.max(0,v);draw()}\n$('motion').onchange=e=>setSource(e.target.value);$('play').onclick=()=>{playing=!playing;last=performance.now();draw()};$('reset').onclick=()=>setTime(0);$('timeline').oninput=e=>{playing=false;setTime(Number(e.target.value)*duration())};$('speed').onchange=e=>speed=Number(e.target.value);$('view').onchange=draw;for(const id of ['bones','regions','sleeves','wire'])$(id).onchange=draw;\nfunction inspect(){joint=$('joint').value||null;playing=false;const angle=Number($('joint-angle').value)*Math.PI/180;$('joint-value').textContent=$('joint-angle').value+'°';for(const s of stages)s.rig.inspect(joint,angle,joint?.startsWith('neck')||joint==='head'?[1,0,0]:[0,1,0]);draw()}\n$('joint').onchange=inspect;$('joint-angle').oninput=inspect;\n$('loading').hidden=true;$('status').textContent='R04：完整形态与局部关节绑定。头部和胸腹核心保持形状，连接区域局部弯曲；颜色标记可查看身体归属和局部变形范围。基础飞行待你检验，物种自然动作仍需逐项校准。';\nwindow.birdWorkbench={setSource,setTime,pause(){playing=false;draw()},play(){playing=true;last=performance.now()},getState(){return{source,time,duration:duration(),playing,joint}},getStages:()=>stages};window.ready=true;draw();\nfunction tick(now){const dt=Math.min(.10,(now-last)/1000);last=now;if(playing&&source!=='static'&&!joint){time+=dt*speed;draw()}requestAnimationFrame(tick)}requestAnimationFrame(tick);\n"},surfaces={"source_4":"