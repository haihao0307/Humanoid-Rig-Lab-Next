{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kaopu:animal-package:1.1",
  "title": "Kaopu complete animal exchange package 1.1",
  "description": "Structural contract only. Instrument identity, range checks and a real preview remain required.",
  "oneOf": [
    {
      "$ref": "#/$defs/animalPackage"
    },
    {
      "$ref": "#/$defs/content"
    }
  ],
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ageYears",
        "growthStage",
        "bodyCondition",
        "health",
        "color"
      ],
      "properties": {
        "schema": {
          "const": "kaopu/profile@1"
        },
        "ageYears": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "growthStage": {
          "anyOf": [
            {
              "enum": [
                "newborn",
                "juvenile",
                "growing",
                "adult",
                "senior"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "bodyCondition": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "health": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "basic": {
      "type": "object",
      "required": [
        "schema",
        "units",
        "referenceSpanM",
        "massKg",
        "sourceSpan",
        "metersPerUnit",
        "basis",
        "stage",
        "measure"
      ],
      "properties": {
        "schema": {
          "const": "kaopu/basic@1"
        },
        "units": {
          "type": "object",
          "required": [
            "length",
            "mass"
          ],
          "properties": {
            "length": {
              "const": "m"
            },
            "mass": {
              "const": "kg"
            }
          }
        },
        "referenceSpanM": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 100
        },
        "massKg": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 200000
        },
        "sourceSpan": {
          "type": "number",
          "minimum": 1e-8,
          "maximum": 1000000
        },
        "metersPerUnit": {
          "type": "number",
          "minimum": 1e-9,
          "maximum": 100000000
        },
        "basis": {
          "enum": [
            "planning-estimate",
            "user-declared"
          ]
        },
        "stage": {
          "type": "string",
          "maxLength": 80
        },
        "measure": {
          "const": "reference-pose-maximum-span"
        }
      },
      "description": "metersPerUnit must equal referenceSpanM/sourceSpan; checked semantically"
    },
    "instrument": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "assetSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "description": "Same exact ID/version/fingerprint in package and score; engine registration checked by receiver"
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 80,
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "maxLength": 200
          }
        ]
      },
      "description": "Only controls/actions declared by the matching instrument; knowledge/curves remain in notation/extensions"
    },
    "score": {
      "type": "object",
      "required": [
        "schema",
        "instrument",
        "parameters"
      ],
      "properties": {
        "schema": {
          "const": "kaopu/score@1"
        },
        "instrument": {
          "$ref": "#/$defs/instrument"
        },
        "animalId": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "notation": {
          "type": "string",
          "maxLength": 100000,
          "pattern": "^K[45]\\|"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "basicData": {
          "$ref": "#/$defs/basic"
        }
      }
    },
    "animalPackage": {
      "type": "object",
      "required": [
        "schema",
        "animal",
        "instrument",
        "score"
      ],
      "properties": {
        "schema": {
          "const": "kaopu/animal@1"
        },
        "animal": {
          "type": "object",
          "required": [
            "name",
            "category",
            "basicData",
            "profile"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "category": {
              "enum": [
                "land",
                "ocean",
                "birds",
                "coast"
              ]
            },
            "basicData": {
              "$ref": "#/$defs/basic"
            },
            "profile": {
              "$ref": "#/$defs/profile"
            }
          }
        },
        "instrument": {
          "$ref": "#/$defs/instrument"
        },
        "score": {
          "$ref": "#/$defs/score"
        },
        "asset": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "format",
                "encoding",
                "data"
              ],
              "properties": {
                "format": {
                  "const": "glb"
                },
                "encoding": {
                  "const": "base64"
                },
                "data": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "format",
                "animalId"
              ],
              "properties": {
                "format": {
                  "const": "atlas-reference"
                },
                "animalId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "asset"
          ]
        },
        {
          "properties": {
            "score": {
              "required": [
                "notation"
              ]
            }
          }
        }
      ]
    },
    "content": {
      "type": "object",
      "required": [
        "schema",
        "payload"
      ],
      "properties": {
        "schema": {
          "const": "kaopu/content@1"
        },
        "payload": {
          "allOf": [
            {
              "$ref": "#/$defs/animalPackage"
            },
            {
              "not": {
                "required": [
                  "asset"
                ],
                "properties": {
                  "asset": {
                    "required": [
                      "format"
                    ],
                    "properties": {
                      "format": {
                        "const": "atlas-reference"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "knowledge": {
          "type": "object"
        },
        "extensions": {
          "type": "object"
        }
      }
    }
  }
}
