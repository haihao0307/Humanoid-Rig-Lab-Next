        "browRaiseLeft", "browRaiseRight", "browDownLeft", "browDownRight",
        "browInnerLeft", "browInnerRight", "browAngryLeft", "browAngryRight", "browInnerUp",
        "mouthSmileLeft", "mouthSmileRight", "mouthFrownLeft", "mouthFrownRight",
        "lipTightenerLeft", "lipTightenerRight", "mouthOpen", "mouthPuckerLeft", "mouthPuckerRight",
        "jawOpen", "jawLeft", "jawRight",
        "cheekPuff", "cheekPuffLeft", "cheekPuffRight", "cheekSquintLeft", "cheekSquintRight"
      ],
      "properties": {
        "eyeBlinkLeft": { "$ref": "#/$defs/channel" },
        "eyeBlinkRight": { "$ref": "#/$defs/channel" },
        "eyeClosureLeft": { "$ref": "#/$defs/channel" },
        "eyeClosureRight": { "$ref": "#/$defs/channel" },
        "eyeUpperLidRaiseLeft": { "$ref": "#/$defs/channel" },
        "eyeUpperLidRaiseRight": { "$ref": "#/$defs/channel" },
        "eyeLowerLidLeft": { "$ref": "#/$defs/channel" },
        "eyeLowerLidRight": { "$ref": "#/$defs/channel" },
        "eyeWideLeft": { "$ref": "#/$defs/channel" },
        "eyeWideRight": { "$ref": "#/$defs/channel" },
        "eyeSquintLeft": { "$ref": "#/$defs/channel" },
        "eyeSquintRight": { "$ref": "#/$defs/channel" },
        "eyeGlareLeft": { "$ref": "#/$defs/channel" },
        "eyeGlareRight": { "$ref": "#/$defs/channel" },
        "browRaiseLeft": { "$ref": "#/$defs/channel" },
        "browRaiseRight": { "$ref": "#/$defs/channel" },
        "browDownLeft": { "$ref": "#/$defs/channel" },
        "browDownRight": { "$ref": "#/$defs/channel" },
        "browInnerLeft": { "$ref": "#/$defs/channel" },
        "browInnerRight": { "$ref": "#/$defs/channel" },
        "browAngryLeft": { "$ref": "#/$defs/channel" },
        "browAngryRight": { "$ref": "#/$defs/channel" },
        "browInnerUp": { "$ref": "#/$defs/channel" },
        "mouthSmileLeft": { "$ref": "#/$defs/channel" },
        "mouthSmileRight": { "$ref": "#/$defs/channel" },
        "mouthFrownLeft": { "$ref": "#/$defs/channel" },
        "mouthFrownRight": { "$ref": "#/$defs/channel" },
        "lipTightenerLeft": { "$ref": "#/$defs/channel" },
        "lipTightenerRight": { "$ref": "#/$defs/channel" },
        "mouthOpen": { "$ref": "#/$defs/channel" },
        "mouthPuckerLeft": { "$ref": "#/$defs/channel" },
        "mouthPuckerRight": { "$ref": "#/$defs/channel" },
        "jawOpen": { "$ref": "#/$defs/channel" },
        "jawLeft": { "$ref": "#/$defs/channel" },
        "jawRight": { "$ref": "#/$defs/channel" },
        "cheekPuff": { "$ref": "#/$defs/channel" },
        "cheekPuffLeft": { "$ref": "#/$defs/channel" },
        "cheekPuffRight": { "$ref": "#/$defs/channel" },
        "cheekSquintLeft": { "$ref": "#/$defs/channel" },
        "cheekSquintRight": { "$ref": "#/$defs/channel" }
      }
    }
  },
  "$defs": {
    "channel": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "x-mirror-pairs": [
    ["eyeBlinkLeft", "eyeBlinkRight"],
    ["eyeClosureLeft", "eyeClosureRight"],
    ["eyeUpperLidRaiseLeft", "eyeUpperLidRaiseRight"],
    ["eyeLowerLidLeft", "eyeLowerLidRight"],
    ["eyeWideLeft", "eyeWideRight"],
    ["eyeSquintLeft", "eyeSquintRight"],
    ["eyeGlareLeft", "eyeGlareRight"],
    ["browRaiseLeft", "browRaiseRight"],
    ["browDownLeft", "browDownRight"],
    ["browInnerLeft", "browInnerRight"],
    ["browAngryLeft", "browAngryRight"],
    ["mouthSmileLeft", "mouthSmileRight"],
    ["mouthFrownLeft", "mouthFrownRight"],
    ["lipTightenerLeft", "lipTightenerRight"],
    ["mouthPuckerLeft", "mouthPuckerRight"],
    ["jawLeft", "jawRight"],
    ["cheekPuffLeft", "cheekPuffRight"],
    ["cheekSquintLeft", "cheekSquintRight"]
