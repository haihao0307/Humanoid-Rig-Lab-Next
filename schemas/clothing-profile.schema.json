{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "humanoid_rig/clothing_profile@1.0",
  "title": "Humanoid Rig Lab ClothingProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["clothing_profile_id", "character_id", "version", "assets"],
  "properties": {
    "clothing_profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "character_id": { "type": ["string", "null"] },
    "version": { "type": "integer", "minimum": 1 },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/clothingAsset" }
    }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "clothingAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clothing_id", "revision", "type", "rig_profile", "material", "physics_profile", "size_profile"],
      "properties": {
        "clothing_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "revision": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["top", "pants", "shoes"] },
        "rig_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "rig_revision", "attachment_points"],
          "properties": {
            "target": { "const": "simulationRig" },
            "rig_revision": { "type": "string", "minLength": 1 },
            "attachment_points": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_color", "roughness", "metalness", "opacity"],
          "properties": {
            "base_color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "roughness": { "$ref": "#/$defs/unit" },
            "metalness": { "$ref": "#/$defs/unit" },
            "opacity": { "$ref": "#/$defs/unit" }
          }
        },
        "physics_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "enabled", "collision"],
          "properties": {
            "mode": { "const": "static-follow" },
            "enabled": { "const": false },
            "collision": { "enum": ["none", "body-readonly"] }
          }
        },
        "size_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "scale", "body_shape_revision"],
          "properties": {
            "size": { "enum": ["XS", "S", "M", "L", "XL", "custom"] },
            "scale": { "type": "number", "minimum": 0.5, "maximum": 2 },
            "body_shape_revision": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
