{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "humanoid_rig/motion_solver_frame@1.0",
  "title": "MotionSolverFrame",
  "type": "object",
  "required": ["schema", "goalId", "time", "deltaTime", "compatibleRig", "outgoingPose", "root", "jointRotations", "fk", "positions", "worldRotations", "contacts", "balance", "taskReports", "diagnostics"],
  "properties": {
    "schema": { "const": "humanoid_rig/motion_solver_frame@1.0" },
    "goalId": { "type": ["string", "null"] },
    "time": { "type": "number" },
    "deltaTime": { "type": "number", "minimum": 0 },
    "compatibleRig": { "type": "string" },
    "outgoingPose": { "type": "object" },
    "root": {
      "type": "object",
      "required": ["position", "rotation"],
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "rotation": { "$ref": "#/$defs/quaternion" }
      },
      "additionalProperties": false
    },
    "jointRotations": { "type": "object", "additionalProperties": { "$ref": "#/$defs/quaternion" } },
    "fk": { "type": "object" },
    "positions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/vector3" } },
    "worldRotations": { "type": "object", "additionalProperties": { "$ref": "#/$defs/quaternion" } },
    "contacts": { "type": "array", "items": { "$ref": "motion-contact.schema.json" } },
    "balance": { "type": "object" },
    "taskReports": { "type": "array", "items": { "type": "object" } },
    "diagnostics": { "type": "object" }
  },
  "$defs": {
    "vector3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "quaternion": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
  },
  "additionalProperties": false
}
