{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "humanoid_rig/motion_contact@1.0",
  "title": "MotionContact",
  "type": "object",
  "required": ["contactId", "jointId", "mode", "targetPosition", "normal", "positionWeight", "rotationWeight", "active"],
  "properties": {
    "contactId": { "type": "string", "minLength": 1 },
    "jointId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["world_lock", "position", "orientation", "surface", "grasp", "seat"] },
    "targetPosition": { "$ref": "#/$defs/vector3" },
    "targetRotation": { "anyOf": [{ "$ref": "#/$defs/quaternion" }, { "type": "null" }] },
    "normal": { "$ref": "#/$defs/vector3" },
    "friction": { "type": "number", "minimum": 0 },
    "positionWeight": { "$ref": "#/$defs/unit" },
    "rotationWeight": { "$ref": "#/$defs/unit" },
    "phase": { "$ref": "#/$defs/unit" },
    "active": { "type": "boolean" },
    "releaseProgress": { "$ref": "#/$defs/unit" },
    "priority": { "type": "number" },
    "contactBlendIn": { "type": "number", "exclusiveMinimum": 0 },
    "contactBlendOut": { "type": "number", "exclusiveMinimum": 0 }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "vector3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  },
  "additionalProperties": false
}
