{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanoid-rig-lab-next.local/schemas/motion-intent.schema.json",
  "title": "MotionIntent",
  "type": "object",
  "required": [
    "schema",
    "intentId",
    "sourceText",
    "language",
    "actions",
    "sequenceRelations",
    "parallelRelations",
    "constraints",
    "confidence",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "humanoid_rig/motion_intent@1.0" },
    "intentId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "sourceText": { "type": "string" },
    "language": { "enum": ["zh", "en", "mixed", "unknown"] },
    "actor": { "type": ["string", "null"] },
    "actorContextRef": { "type": ["string", "null"] },
    "occupationHint": { "type": ["string", "null"] },
    "taskType": { "type": ["string", "null"] },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actionId", "verb", "skillId"],
        "properties": {
          "actionId": { "type": "string" },
          "verb": { "type": "string" },
          "skillId": { "type": ["string", "null"] },
          "direction": { "type": ["string", "null"] },
          "side": { "enum": ["left", "right", "both", "none", null] },
          "target": { "type": ["string", "null"] },
          "targetType": { "type": ["string", "null"] },
          "distanceMeters": { "type": ["number", "null"], "minimum": 0 },
          "stepCount": { "type": ["integer", "null"], "minimum": 1 },
          "durationSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "speed": { "enum": ["slow", "normal", "fast", "gentle", "large", "small", null] },
          "angleDegrees": { "type": ["number", "null"], "minimum": -360, "maximum": 360 },
          "repeatCount": { "type": ["integer", "null"], "minimum": 1 },
          "modifiers": { "type": "array", "items": { "type": "string" } },
          "warnings": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "direction": { "type": ["string", "null"] },
    "side": { "enum": ["left", "right", "both", "none", null] },
    "target": { "type": ["string", "null"] },
    "distanceMeters": { "type": ["number", "null"], "minimum": 0 },
    "stepCount": { "type": ["integer", "null"], "minimum": 1 },
    "durationSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "speed": { "enum": ["slow", "normal", "fast", "gentle", "large", "small", null] },
    "angleDegrees": { "type": ["number", "null"], "minimum": -360, "maximum": 360 },
    "repeatCount": { "type": ["integer", "null"], "minimum": 1 },
    "sequenceRelations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["beforeActionId", "afterActionId"],
        "properties": {
          "beforeActionId": { "type": "string" },
          "afterActionId": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "parallelRelations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["groupId", "actionIds"],
        "properties": {
          "groupId": { "type": "string" },
          "actionIds": { "type": "array", "minItems": 2, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "targets": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "spatialRelations": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "conditions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "constraints": { "type": "object", "additionalProperties": true },
    "styleHints": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "equipmentHints": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "safetyHints": { "type": "array", "items": {} },
    "confidenceByField": { "type": "object", "additionalProperties": true },
    "unresolvedTokens": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["ready", "unsupported", "empty"] },
    "missingSkills": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
