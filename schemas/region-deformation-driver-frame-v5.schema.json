{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "humanoid_rig/region_deformation_driver_frame@5.0",
  "title": "Region Deformation Driver Frame V5",
  "type": "object",
  "required": ["schema", "schemaVersion", "type", "humanId", "rigId", "proportionRevision", "sourcePoseAuthority", "regions", "timestamp"],
  "properties": {
    "schema": { "const": "humanoid_rig/region_deformation_driver_frame@5.0" },
    "schemaVersion": { "const": 5 },
    "type": { "const": "RegionDeformationDriverFrame" },
    "humanId": { "type": "string" },
    "rigId": { "type": "string" },
    "proportionRevision": { "type": "integer", "minimum": 0 },
    "sourcePoseAuthority": { "const": "finalPose.localRotations" },
    "regions": {
      "type": "object",
      "required": ["leftShoulder","rightShoulder","leftElbow","rightElbow","leftWrist","rightWrist","leftHip","rightHip","leftKnee","rightKnee","leftAnkle","rightAnkle","chest","abdomen","pelvis"],
      "additionalProperties": { "$ref": "#/$defs/driver" }
    },
    "timestamp": { "type": "number" }
  },
  "$defs": {
    "driver": {
      "type": "object",
      "required": ["bend","twist","side","compression","tension","volume","elevation","activation","confidence","sourceJointIds","sourcePoseAuthority"],
      "properties": {
        "bend":{"type":"number"}, "twist":{"type":"number"}, "side":{"type":"number"},
        "compression":{"type":"number","minimum":0,"maximum":1}, "tension":{"type":"number","minimum":0,"maximum":1},
        "volume":{"type":"number"}, "elevation":{"type":"number","minimum":0,"maximum":1},
        "activation":{"type":"number","minimum":0,"maximum":1}, "confidence":{"type":"number","minimum":0,"maximum":1},
        "sourceJointIds":{"type":"array","items":{"type":"string"}}, "sourcePoseAuthority":{"const":"finalPose.localRotations"}
      }
    }
  }
}
