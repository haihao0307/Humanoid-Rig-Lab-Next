{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "humanoid_rig/face_feature_descriptor@1.0",
  "title": "Humanoid Rig Lab FaceFeatureDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "descriptorRevision", "source", "face_shape", "eye_shape", "mouth_shape", "expression"],
  "properties": {
    "schema": { "const": "humanoid_rig/face_feature_descriptor@1.0" },
    "descriptorRevision": { "type": "integer", "minimum": 1 },
    "source": { "$ref": "#/$defs/imageInput" },
    "face_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "jaw_width", "cheekbone"],
      "properties": {
        "width": { "$ref": "#/$defs/parameter" },
        "height": { "$ref": "#/$defs/parameter" },
        "jaw_width": { "$ref": "#/$defs/parameter" },
        "cheekbone": { "$ref": "#/$defs/parameter" }
      }
    },
    "eye_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "spacing", "tilt"],
      "properties": {
        "size": { "$ref": "#/$defs/parameter" },
        "spacing": { "$ref": "#/$defs/parameter" },
        "tilt": { "$ref": "#/$defs/parameter" }
      }
    },
    "mouth_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "fullness", "corner_curve"],
      "properties": {
        "width": { "$ref": "#/$defs/parameter" },
        "fullness": { "$ref": "#/$defs/parameter" },
        "corner_curve": { "$ref": "#/$defs/parameter" }
      }
    },
    "expression": { "$ref": "face-expression.schema.json" }
  },
  "$defs": {
    "parameter": { "type": "number", "minimum": 0, "maximum": 1 },
    "imageInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "type", "reference", "mediaType", "width", "height"],
      "properties": {
        "schema": { "const": "humanoid_rig/face_image_input@1.0" },
        "type": { "const": "image" },
        "reference": { "type": ["string", "null"] },
        "mediaType": { "type": ["string", "null"] },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
