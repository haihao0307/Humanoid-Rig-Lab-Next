{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanoid-rig-lab-next.local/schemas/motion-execution-session.schema.json",
  "title": "MotionExecutionSession",
  "type": "object",
  "required": [
    "schema",
    "sessionId",
    "planId",
    "graphId",
    "actorId",
    "status",
    "currentNodeId",
    "completedNodeIds",
    "failedNodeIds",
    "startedAt",
    "updatedAt",
    "elapsed",
    "progress",
    "activeSkills",
    "warnings",
    "lastError",
    "recoveryState"
  ],
  "properties": {
    "schema": { "const": "humanoid_rig/motion_execution_session@1.0" },
    "sessionId": { "type": "string" },
    "planId": { "type": ["string", "null"] },
    "graphId": { "type": ["string", "null"] },
    "actorId": { "type": ["string", "null"] },
    "status": { "enum": ["idle", "prepared", "running", "paused", "completed", "failed", "cancelled", "recovering"] },
    "currentNodeId": { "type": ["string", "null"] },
    "completedNodeIds": { "type": "array", "items": { "type": "string" } },
    "failedNodeIds": { "type": "array", "items": { "type": "string" } },
    "startedAt": { "type": ["string", "null"] },
    "updatedAt": { "type": ["string", "null"] },
    "elapsed": { "type": "number", "minimum": 0 },
    "progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "activeSkills": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "lastError": { "type": ["object", "null"], "additionalProperties": true },
    "recoveryState": { "type": ["object", "null"], "additionalProperties": true }
  },
  "additionalProperties": true
}
