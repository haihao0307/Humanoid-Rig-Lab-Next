{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "humanoid_rig/human_balance_state@5.0",
  "title": "Humanoid Rig Lab HumanBalanceState V5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "type", "humanId", "rigId", "centerOfMass", "supportArea", "stability", "lean", "correctionHint", "integration"],
  "properties": {
    "schema": { "const": "humanoid_rig/human_balance_state@5.0" },
    "schemaVersion": { "const": 5 },
    "type": { "const": "HumanBalanceState" },
    "humanId": { "$ref": "#/$defs/stableId" },
    "rigId": { "$ref": "#/$defs/stableId" },
    "centerOfMass": { "type": "object" },
    "supportArea": { "type": "object" },
    "stability": { "type": "object" },
    "lean": { "type": "object" },
    "correctionHint": { "type": "object" },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "usesWorldPositions", "replacesWholeBodySolver", "writesPose"],
      "properties": {
        "mode": { "const": "semantic-observer-only" },
        "usesWorldPositions": { "const": false },
        "replacesWholeBodySolver": { "const": false },
        "writesPose": { "const": false }
      }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" }
  }
}
