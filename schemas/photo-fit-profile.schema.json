{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:humanoid-rig:photo-fit-profile:0.1",
  "title": "Humanoid Rig Photo Fit Profile R0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "projectId",
    "subjectId",
    "revision",
    "createdAt",
    "mode",
    "coordinateSystem",
    "policy",
    "sourceImages",
    "calibration",
    "landmarks",
    "measurements",
    "candidateMorphs",
    "morphEvidence",
    "warnings",
    "appliedStages",
    "base"
  ],
  "properties": {
    "schema": {"const": "humanoid_rig/photo_fit_profile@0.1"},
    "version": {"type": "string", "minLength": 1},
    "projectId": {"type": "string", "minLength": 1},
    "subjectId": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["full", "head"]},
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "rig"],
      "properties": {
        "image": {"const": "normalized-top-left"},
        "rig": {"const": "right-handed-Y-up-Z-forward"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceImagePersistence", "mapping", "automaticIdentityClaim", "depthInference", "heightApplication"],
      "properties": {
        "sourceImagePersistence": {"const": "not-embedded"},
        "mapping": {"const": "engineering-anchor-r0"},
        "automaticIdentityClaim": {"const": false},
        "depthInference": {"const": "unknown-unless-multiview"},
        "heightApplication": {"type": "string", "minLength": 1}
      }
    },
    "sourceImages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["imageId", "fileName", "mimeType", "width", "height", "sha256", "storage"],
        "properties": {
          "imageId": {"type": "string", "minLength": 1},
          "fileName": {"type": "string"},
          "mimeType": {"type": "string"},
          "width": {"type": ["integer", "null"], "minimum": 1},
          "height": {"type": ["integer", "null"], "minimum": 1},
          "sha256": {"type": ["string", "null"]},
          "storage": {"const": "local-session-only"}
        }
      }
    },
    "calibration": {
      "type": "object",
      "required": ["knownHeightM", "pxPerMeter", "heightApplication"],
      "properties": {
        "knownHeightM": {"type": ["number", "null"], "minimum": 0.8, "maximum": 2.5},
        "pxPerMeter": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "heightApplication": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "landmarks": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {"$ref": "#/$defs/landmark"}
    },
    "measurements": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {"$ref": "#/$defs/measurement"}
    },
    "candidateMorphs": {"$ref": "#/$defs/morphs"},
    "morphEvidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "baseValue", "targetValue"],
        "properties": {
          "status": {"enum": ["candidate", "manual", "unknown", "unchanged"]},
          "sourceMeasurement": {"type": ["string", "null"]},
          "observedValue": {"type": "number"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "anchorValue": {"type": "number"},
          "baseValue": {"type": "number"},
          "targetValue": {"type": "number"},
          "unclampedValue": {"type": "number"},
          "clamped": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/warning"}
    },
    "appliedStages": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["rig", "torso", "face", "volume"]}
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "bodyPlanRevision", "bodyArchetype", "bodySex", "statureM", "morphs"],
      "properties": {
        "schema": {"type": ["string", "null"]},
        "bodyPlanRevision": {"type": ["integer", "null"]},
        "bodyArchetype": {"type": ["string", "null"]},
        "bodySex": {"type": ["string", "null"]},
        "statureM": {"type": ["number", "null"]},
        "morphs": {"$ref": "#/$defs/morphs"}
      }
    }
  },
  "$defs": {
    "landmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "confidence", "source"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source": {"enum": ["manual", "adapter", "inferred"]}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "sourceLandmarks", "status"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "sourceLandmarks": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["observed", "manual", "unknown"]}
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "morphs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shoulderWidth", "chestWidth", "waistWidth", "hipWidth", "neckWidth", "limbVolume", "softness", "breastProjectionM", "faceWidth"],
      "properties": {
        "shoulderWidth": {"type": "number", "minimum": 0.8, "maximum": 1.18},
        "chestWidth": {"type": "number", "minimum": 0.82, "maximum": 1.18},
        "waistWidth": {"type": "number", "minimum": 0.78, "maximum": 1.2},
        "hipWidth": {"type": "number", "minimum": 0.86, "maximum": 1.25},
        "neckWidth": {"type": "number", "minimum": 0.82, "maximum": 1.14},
        "limbVolume": {"type": "number", "minimum": 0.78, "maximum": 1.22},
        "softness": {"type": "number", "minimum": 0.65, "maximum": 1.45},
        "breastProjectionM": {"type": "number", "minimum": 0, "maximum": 0.1},
        "faceWidth": {"type": "number", "minimum": 0.9, "maximum": 1.08}
      }
    }
  }
}
